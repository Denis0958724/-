# Скопіюйте цей файл у .env і заповніть. Файл .env у git не потрапляє.
PORT=3000
# Адреса, з якою відкривають сайт. Потрібна для посилань у листах.
BASE_URL=http://localhost:3000
# Gmail: адреса і пароль застосунку (див. README, розділ «Пошта»)
GMAIL_USER=
GMAIL_APP_PASSWORD=
MAIL_FROM_NAME=Askly
# Лише для розробки: листи друкуються в консоль замість відправки
# MAIL_MODE=log
# Демо-фахівці: 1 показувати, 0 ні
SEED_DEMO=1
