<!doctype html>
<html lang="uk">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Мікро-консультації · прототип</title>
<style>
  /* Базові стилі. Розміщення елементів ще не фінальне. */
  * { box-sizing: border-box; }
  body { margin: 0; font-family: system-ui, -apple-system, "Segoe UI", sans-serif; font-size: 16px; line-height: 1.45; background: #f4f4f4; color: #222; }
  a { color: #1a4fa0; }
  header.top { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px 16px; background: #fff; border-bottom: 1px solid #ccc; padding: 8px 16px; }
  .brand { font-weight: 700; color: #222; text-decoration: none; }
  nav.main { display: flex; flex-wrap: wrap; gap: 4px 14px; align-items: center; font-size: 15px; }
  nav.main a { color: #222; }
  nav.main a[aria-current=page] { font-weight: 700; }
  #stepsBar { background: #fff; border-bottom: 1px solid #ddd; padding: 6px 16px; }
  #steps, .wsteps { display: flex; flex-wrap: wrap; gap: 4px; list-style: none; padding: 0; margin: 0; font-size: 13px; }
  .wsteps { margin: 0 0 12px; }
  #steps li, .wsteps li { padding: 2px 8px; border: 1px solid #ccc; border-radius: 10px; color: #777; }
  #steps li.done, .wsteps li.done { background: #e6f2e6; color: #333; }
  #steps li.current, .wsteps li.current { background: #333; color: #fff; border-color: #333; }
  .layout { display: grid; grid-template-columns: 1fr 320px; gap: 16px; padding: 16px; max-width: 1200px; margin: 0 auto; }
  body.no-panel .layout { grid-template-columns: 1fr; max-width: 820px; }
  body.no-panel aside { display: none; }
  @media (max-width: 860px) { .layout { grid-template-columns: 1fr; } }
  main, aside { background: #fff; border: 1px solid #ccc; padding: 16px; min-width: 0; }
  main:focus { outline: none; }
  h1, h2 { margin-top: 0; }
  h1:focus, h2:focus { outline: none; }
  h3 { margin: 16px 0 8px; font-size: 17px; }
  label { display: block; margin: 12px 0 4px; font-weight: 600; }
  label.inline { display: inline-block; margin-right: 12px; font-weight: 400; }
  fieldset { border: 0; padding: 0; margin: 12px 0 0; }
  legend { font-weight: 600; padding: 0; margin-bottom: 4px; }
  .radio-col label { display: flex; gap: 6px; align-items: flex-start; font-weight: 400; margin: 6px 0; }
  .radio-row label { display: inline-flex; gap: 4px; align-items: center; font-weight: 400; margin: 4px 14px 4px 0; }
  input:not([type=checkbox]):not([type=radio]):not([type=file]), select, textarea { width: 100%; padding: 8px; font: inherit; border: 1px solid #999; background: #fff; }
  input.short { max-width: 160px; }
  label.inline select { width: auto; }
  textarea { min-height: 110px; resize: vertical; }
  [aria-invalid=true] { border-color: #b00020 !important; }
  .hint { font-size: 13px; color: #666; margin: 2px 0; }
  .error { color: #b00020; font-size: 14px; margin: 4px 0; }
  .warn { background: #fff4d6; border: 1px solid #e0b84a; padding: 8px; margin: 8px 0; font-size: 14px; }
  .ok { background: #e6f2e6; border: 1px solid #8bbf8b; padding: 8px; margin: 8px 0; }
  .notice { background: #eef3fb; border: 1px solid #9db3d6; padding: 8px; margin: 0 0 12px; font-size: 14px; }
  .actions { display: flex; gap: 8px; margin-top: 16px; flex-wrap: wrap; }
  button { font: inherit; padding: 8px 14px; cursor: pointer; border: 1px solid #333; background: #fff; color: #222; }
  button.primary { background: #333; color: #fff; }
  button.small { padding: 3px 8px; font-size: 13px; }
  button:disabled { opacity: .5; cursor: not-allowed; }
  .card { border: 1px solid #ccc; padding: 12px; margin: 8px 0; }
  .row { display: flex; justify-content: space-between; gap: 8px; flex-wrap: wrap; }
  .badge { display: inline-block; font-size: 12px; padding: 1px 6px; border: 1px solid #999; border-radius: 8px; margin-left: 4px; }
  .slots { display: flex; flex-wrap: wrap; gap: 6px; margin-bottom: 8px; }
  .slot[aria-pressed=true], .star[aria-pressed=true] { background: #333; color: #fff; }
  .video { background: #222; color: #eee; height: 240px; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 6px; }
  table { border-collapse: collapse; width: 100%; font-size: 15px; }
  td { border-bottom: 1px solid #eee; padding: 4px 0; vertical-align: top; }
  td:first-child { color: #666; width: 38%; padding-right: 8px; }
  ul.reasons { margin: 6px 0; padding-left: 0; list-style: none; font-size: 14px; }
  ul.reasons li.minus { color: #8a3b00; }
  ul.files { list-style: none; padding: 0; margin: 4px 0; font-size: 14px; }
  ul.files li { display: flex; gap: 8px; align-items: center; }
  .match { font-weight: 700; }
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 8px; }
  .grid .card { margin: 0; }
  .grid .card h3 { margin-top: 0; }
  ol.how { padding-left: 20px; }
  ol.how li { margin: 6px 0; }
  .spinner { display: inline-block; width: 14px; height: 14px; border: 2px solid #999; border-top-color: transparent; border-radius: 50%; animation: spin .8s linear infinite; vertical-align: -2px; margin-right: 6px; }
  @keyframes spin { to { transform: rotate(360deg); } }
  #log { font-family: ui-monospace, monospace; font-size: 12px; max-height: 240px; overflow: auto; background: #fafafa; border: 1px solid #ddd; padding: 6px; white-space: pre-wrap; }
  dl.metrics { display: grid; grid-template-columns: 1fr auto; gap: 2px 8px; font-size: 14px; margin: 8px 0 12px; }
  dl.metrics dd { margin: 0; text-align: right; font-variant-numeric: tabular-nums; }
  aside h3 { margin: 12px 0 6px; font-size: 15px; }
  aside h3:first-child { margin-top: 0; }
  aside label { margin-top: 0; font-weight: 400; font-size: 14px; }
</style>
</head>
<body>
<header class="top">
  <a class="brand" href="#/">Мікро-консультації</a>
  <nav class="main" id="nav" aria-label="Головне меню"></nav>
  <button class="small" id="togglePanel" type="button">Сховати панель тесту</button>
</header>
<div id="stepsBar" hidden><ol id="steps" aria-label="Кроки"></ol></div>

<div class="layout">
  <main id="main" tabindex="-1"></main>

  <aside id="panel" aria-label="Панель тестування">
    <h3>Тест зручності</h3>
    <label for="scenario">Сценарій</label>
    <select id="scenario"></select>
    <dl class="metrics">
      <dt>Загальний час</dt><dd id="mTotal">—</dd>
      <dt>Поточний екран</dt><dd id="mScreen">—</dd>
      <dt>Опис запиту</dt><dd id="mForm">—</dd>
      <dt>Від запиту до бронювання</dt><dd id="mBooking">—</dd>
      <dt>Уточнень для AI / «AI помилився»</dt><dd id="mAi">0 / 0</dd>
      <dt>Реєстрація фахівця</dt><dd id="mExpert">—</dd>
      <dt>Кліки</dt><dd id="mClicks">0</dd>
      <dt>Повернення назад</dt><dd id="mBacks">0</dd>
      <dt>Помилки валідації</dt><dd id="mErrors">0</dd>
      <dt>Змін у полях</dt><dd id="mEdits">0</dd>
    </dl>
    <h3>Журнал подій</h3>
    <div id="log"></div>
    <div class="actions">
      <a class="small" href="#/results" id="reportLink">Звіт тесту</a>
      <button class="small" type="button" id="exportBtn">Експорт JSON</button>
      <button class="small" type="button" id="resetBtn">Новий учасник</button>
    </div>
    <details id="exportFallback" hidden>
      <summary>JSON для копіювання</summary>
      <p class="hint">Якщо файл не завантажився (наприклад, у вбудованому перегляді), скопіюйте текст.</p>
      <textarea id="exportText" readonly style="min-height:160px;font-family:ui-monospace,monospace;font-size:12px"></textarea>
    </details>
    <h3>Модератор</h3>
    <p class="hint" id="pendingInfo"></p>
    <div class="actions" style="margin-top:4px">
      <button class="small" type="button" id="approveBtn">Схвалити заявки фахівців</button>
      <button class="small" type="button" id="wipeBtn">Очистити всі дані</button>
    </div>
    <p class="hint" id="storageNote"></p>
  </aside>
</div>

<script>
'use strict';

/* ===================== Утиліти ===================== */
function escRe(s) { return s.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'); }
function norm(s) { return String(s || '').toLowerCase().replace(/[’ʼ`]/g, "'"); }
// \b не працює з кирилицею, тому початок слова — через (?<!\p{L}) і прапорець u
function stemRe(stem, flags = 'giu') { return new RegExp('(?<!\\p{L})' + escRe(stem), flags); }
const $ = (s, r = document) => r.querySelector(s);
const esc = s => String(s ?? '').replace(/[&<>"']/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
const fmt = ms => { if (ms == null || isNaN(ms) || ms < 0) return '—'; const s = Math.round(ms / 1000); return `${Math.floor(s / 60)}:${String(s % 60).padStart(2, '0')}`; };
const uid = p => p + Date.now().toString(36) + Math.random().toString(36).slice(2, 6);
const unique = arr => [...new Set(arr)];
const trunc = (s, n) => (s.length > n ? s.slice(0, n - 1).trimEnd() + '…' : s);
const pad = n => String(n).padStart(2, '0');
// Дати — за місцевим часом (toISOString дає UTC і біля півночі зсуває дату на добу)
const localDate = d => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}`;
const localStamp = d => `${localDate(d)}-${pad(d.getHours())}-${pad(d.getMinutes())}`;
const toMin = t => { const [h, m] = t.split(':').map(Number); return h * 60 + m; };
const fromMin = n => `${pad(Math.floor(n / 60))}:${pad(n % 60)}`;
function labelFor(dateStr) {
  const [y, mo, d] = dateStr.split('-').map(Number);
  const dt = new Date(y, mo - 1, d);
  const today = new Date(); today.setHours(0, 0, 0, 0);
  const diff = Math.round((dt - today) / 86400000);
  if (diff === 0) return 'Сьогодні';
  if (diff === 1) return 'Завтра';
  if (diff === -1) return 'Вчора';
  return dt.toLocaleDateString('uk-UA', { weekday: 'long', day: 'numeric', month: 'long' });
}
const EMAIL_RE = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/;

/* ===================== Довідники ===================== */
// Напрями з паспорта. AI визначає напрям за основами слів у вільному тексті.
const CATEGORIES = [
  { id: 'tax', name: 'Податки і облік', kw: ['подат', 'оподатк', 'фоп', 'облік', 'бухгалт', 'декларац', 'пдфо', 'єсв', 'рро', 'прро', 'звітн', 'пдв', 'акциз'] },
  { id: 'legal', name: 'Договори й юридичні питання', kw: ['догов', 'оренд', 'суд', 'позов', 'юрист', 'юридич', 'претенз', 'спадщ', 'нотар', 'адвокат', 'закон', 'неустойк', 'розірв', 'контрагент', 'довірен'] },
  { id: 'career', name: "Кар'єра і резюме", kw: ['резюме', 'співбесід', 'робот', "кар'єр", 'карєр', 'ваканс', 'зарплат', 'linkedin', 'звільн', 'рекрутер', 'офер', 'оффер', 'підвищен', 'роботодав', 'працевлашт'] },
  { id: 'strategy', name: 'Бізнес-стратегія', kw: ['стратег', 'бізнес-план', 'бізнес план', 'масштаб', 'інвестор', 'стартап', 'конкурент', 'ціноутвор', 'франшиз', 'юніт', 'партнер'] },
  { id: 'marketing', name: 'Маркетинг', kw: ['маркетинг', 'реклам', 'таргет', 'smm', 'інстаграм', 'instagram', 'бренд', 'просуван', 'лендинг', 'seo', 'контент', 'соцмереж'] },
  { id: 'tech', name: 'AI та технології', kw: ['штучн', 'нейромереж', 'chatgpt', 'gpt', 'автоматиз', 'програмуван', 'сайт', 'crm', 'python', 'застосунк', 'застосунок', 'ai'] },
  { id: 'finance', name: 'Фінансова грамотність', kw: ['заощадж', 'інвест', 'кредит', 'іпотек', 'депозит', 'пенсі', 'облігац', 'овдп', 'борг', 'накопич', 'бюджет сім', 'розстрочк'] },
  { id: 'education', name: 'Освіта і навчання за кордоном', kw: ['навчан', 'вступ', 'університет', 'магістр', 'бакалавр', 'грант', 'стипенд', 'ielts', 'toefl', 'мотиваційн', 'за кордон', 'школ'] },
];
const CAT = {};
for (const c of CATEGORIES) { c.res = c.kw.map(k => stemRe(k)); CAT[c.id] = c; }
const catName = id => (CAT[id] || {}).name || '—';

const LEVELS = { student: 'Студент-практик', practitioner: 'Практик', expert: 'Відомий фахівець' };
const LEVEL_PRICE = { student: [100, 250], practitioner: [250, 500], expert: [500, 1200] };
const levelFor = years => (+years < 2 ? 'student' : +years < 8 ? 'practitioner' : 'expert');
const COMMISSION = 0.2;
const URGENCY_LABEL = { today: 'Сьогодні, терміново', week: 'Протягом тижня' };
const RESOLVED = { yes: 'так', partly: 'частково', no: 'ні' };
const WEEKDAYS = ['Пн', 'Вт', 'Ср', 'Чт', 'Пт', 'Сб', 'Нд'];
const MOCK_TIMES = ['09:00', '09:30', '10:00', '11:15', '12:00', '13:30', '15:00', '16:45', '18:00', '19:30', '20:30', '21:15'];
// «лікарнян…» (лікарняні) — не медична тема
const SENSITIVE = /лікар(?!нян)|(?<!\p{L})лік(и|ів|ами)(?!\p{L})|діагноз|хвороб|симптом|аналіз.{0,6}кров|психолог|психотерап|психіатр|депрес|панічн/iu;
const SCENARIOS = {
  fop: 'Клієнт: ФОП не знає, чи переходити на іншу групу',
  lease: 'Клієнт: договір оренди, що перевірити',
  resume: 'Клієнт: резюме, не кличуть на співбесіди',
  vague: 'Клієнт: нечітке питання (перевірка уточнення AI)',
  expert: 'Фахівець: зареєструватися на платформі',
  free: 'Вільне завдання',
};

// Демо-фахівці (вже перевірені). focus: [основа слова для збігу з запитом, як показати клієнту]
const MOCK_EXPERTS = [
  { id: 'm1', cat: 'tax', name: 'Олена Ковальчук', level: 'expert', rating: 4.9, reviews: 87, price: 650, bio: 'Податкова консультантка, 12 років практики.', focus: [['фоп', 'ФОП і єдиний податок'], ['груп', 'вибір групи'], ['перевірк', 'податкові перевірки'], ['пдфо', 'ПДФО']] },
  { id: 'm2', cat: 'tax', name: 'Андрій Мельник', level: 'practitioner', rating: 4.7, reviews: 31, price: 350, bio: 'Бухгалтер для малого бізнесу, веде понад 40 ФОП.', focus: [['звітн', 'звітність'], ['єсв', 'ЄСВ'], ['рро', 'РРО'], ['прро', 'ПРРО'], ['облік', 'облік ФОП']] },
  { id: 'm3', cat: 'tax', name: 'Марія Ткач', level: 'student', rating: 4.5, reviews: 8, price: 150, bio: 'Магістрантка, практика в аудиторській фірмі.', focus: [['груп', 'групи ФОП'], ['декларац', 'декларації']] },
  { id: 'm4', cat: 'legal', name: 'Ігор Бондар', level: 'expert', rating: 4.8, reviews: 64, price: 800, bio: 'Адвокат, договірне право і корпоративні спори.', focus: [['догов', 'договори'], ['суд', 'судові спори'], ['претенз', 'претензії'], ['контрагент', 'спори з контрагентами']] },
  { id: 'm5', cat: 'legal', name: 'Світлана Шевчук', level: 'practitioner', rating: 4.6, reviews: 22, price: 400, bio: 'Юристка: оренда, трудові договори, претензії.', focus: [['оренд', 'оренда'], ['догов', 'договори'], ['звільн', 'трудові питання']] },
  { id: 'm6', cat: 'legal', name: 'Дмитро Олійник', level: 'student', rating: 4.3, reviews: 5, price: 180, bio: 'Студент-правник, юридична клініка університету.', focus: [['оренд', 'оренда житла'], ['спадщ', 'спадщина']] },
  { id: 'm7', cat: 'career', name: 'Ірина Лисенко', level: 'expert', rating: 4.9, reviews: 112, price: 500, bio: 'HR-директорка, 15 років найму в IT та ритейлі.', focus: [['співбесід', 'співбесіди'], ['зарплат', 'переговори про зарплату'], ['офер', 'офери']] },
  { id: 'm8', cat: 'career', name: 'Тарас Кравець', level: 'practitioner', rating: 4.7, reviews: 40, price: 300, bio: 'Рекрутер: резюме, LinkedIn, підготовка до співбесід.', focus: [['резюме', 'резюме'], ['linkedin', 'LinkedIn'], ['ваканс', 'пошук вакансій']] },
  { id: 'm9', cat: 'career', name: 'Наталія Поліщук', level: 'student', rating: 4.4, reviews: 9, price: 120, bio: "Кар'єрна консультантка-стажистка.", focus: [['резюме', 'перше резюме'], ['робот', 'пошук першої роботи']] },
].map(e => ({ ...e, mock: true, verified: true }));
const SAMPLE_REVIEWS = [
  ['Чітко і по суті, за 15 хвилин розібрались.', 'Отримав конкретний план дій.'],
  ['Пояснила складне простими словами.', 'Трохи не вистачило часу, але підсумок допоміг.'],
  ['Дуже уважно вислухав ситуацію.', 'Відповідь була саме на моє питання.'],
];
const SUMMARY_POINTS = {
  tax: ['Порівняли ліміти доходу для вашої і наступної групи.', 'Визначили, з якого кварталу вигідніше переходити.', 'Список документів для подачі заяви.'],
  legal: ['Позначили ризиковані пункти договору.', 'Як сформулювати правки для іншої сторони.', 'Що зберегти як докази.'],
  career: ['Резюме не проходить автоматичний відбір через формат.', 'Переписати перший блок під конкретну вакансію.', 'Додати 2–3 результати в цифрах.'],
};

/* ===================== Сховище (спільне для всіх вкладок) ===================== */
const STORE_KEY = 'micro-consult-proto-v2';
const emptyDb = () => ({ users: [], experts: [], bookings: [], currentUserId: null, expertDraft: null });
let storageOK = true;
let db = (() => {
  try { const raw = localStorage.getItem(STORE_KEY); return raw ? { ...emptyDb(), ...JSON.parse(raw) } : emptyDb(); }
  catch { storageOK = false; return emptyDb(); } // у вбудованому перегляді localStorage недоступний
})();
function commit() {
  if (!storageOK) return;
  try { localStorage.setItem(STORE_KEY, JSON.stringify(db)); } catch { storageOK = false; updatePanelStatic(); }
}
const me = () => db.users.find(u => u.id === db.currentUserId) || null;
const myExpertRecord = () => db.experts.find(e => e.id === db.currentUserId) || null;

/* ===================== Стан сценарію і метрики ===================== */
const freshFlow = () => ({ draft: null, text: '', clarifications: [], excluded: [], analysis: null, analysisKey: '', override: false, clarifyMode: null, expertId: null, slot: null, ui: { lvl: '', sort: 'match' }, waitlisted: false });
let flow = freshFlow();
const fullText = () => [flow.text, ...flow.clarifications].filter(Boolean).join('\n');

const freshTest = () => ({
  scenario: $('#scenario') ? $('#scenario').value : 'fop',
  startedAt: null, finishedAt: null,
  formStartedAt: null, requestSubmittedAt: null, bookedAt: null,
  expertStartedAt: null, expertSubmittedAt: null, expertStepErrors: {},
  clicks: 0, backs: 0, errors: 0, edits: 0, resubmits: 0, clarifications: 0, aiWrong: 0, aiRuns: 0,
  screenTimes: {}, events: [],
});
let test = freshTest();
let current = null, screenEnteredAt = Date.now(), screenInterval = null, renderToken = 0;
let pendingNotice = null, navByApp = false;

function startTest() { if (!test.startedAt) { test.startedAt = Date.now(); log('test_start', SCENARIOS[test.scenario]); } }
function log(type, detail = '') {
  const t = test.startedAt ? Date.now() - test.startedAt : 0;
  test.events.push({ t, type, detail, screen: current });
  const el = $('#log');
  el.textContent += `[${fmt(t)}] ${type}${detail ? ': ' + detail : ''}\n`;
  el.scrollTop = el.scrollHeight;
}
function setErr(id, msg, field) {
  const el = document.getElementById(id);
  if (el) el.textContent = msg || '';
  if (field) field.setAttribute('aria-invalid', msg ? 'true' : 'false');
}
function fail(errs, first, ctx = '') {
  test.errors += errs.length;
  log('validation', (ctx ? ctx + ': ' : '') + errs.join(', '));
  const f = first.find(Boolean);
  if (f) f.focus();
}

/* ===================== AI-аналіз (імітація) =====================
   Усе «розуміння» зібране тут. Щоб підключити справжню модель, достатньо замінити
   analyzeRequest / analyzeExpertise на виклик API з тим самим форматом відповіді. */
function categorize(text, about = '', excluded = []) {
  const t = norm(text), a = norm(about);
  const scores = CATEGORIES.filter(c => !excluded.includes(c.id)).map(c => {
    let s = 0;
    for (const re of c.res) { s += (t.match(re) || []).length + 0.5 * (a.match(re) || []).length; }
    return { id: c.id, score: s };
  }).sort((x, y) => y.score - x.score);
  const total = scores.reduce((n, x) => n + x.score, 0);
  const [best, second] = scores;
  const primary = best && best.score >= 1 ? best.id : null;
  const secondary = primary && second && second.score >= 1 && second.score >= best.score * 0.5 ? second.id : null;
  const confidence = primary ? Math.min(97, Math.round((100 * best.score) / (total + 0.5))) : 0;
  return { primary, secondary, confidence };
}
function wordsFor(text, catIds, limit = 6) {
  const t = norm(text), out = [];
  for (const id of catIds) {
    const c = CAT[id]; if (!c) continue;
    for (const stem of c.kw) {
      const re = new RegExp('(?<!\\p{L})(' + escRe(stem) + "[\\p{L}'-]*)", 'giu');
      // різні форми одного слова («договір», «договору») показуємо один раз
      for (const m of t.matchAll(re)) if (!out.some(w => w.slice(0, 5) === m[1].slice(0, 5))) out.push(m[1]);
    }
  }
  return out.slice(0, limit);
}
function analyzeRequest(text, about = '', excluded = []) {
  const cat = categorize(text, about, excluded);
  const t = norm(text);
  const urgency = /(?<!\p{L})(сьогодні|терміново|негайно|якнайшвидше|зараз|до вечора|asap)/iu.test(t) ? 'today'
    : /(?<!\p{L})(завтра|цього тижня|на тижні|до кінця тижня|до (понеділка|вівторка|середи|четверга|п'ятниці|суботи|неділі))/iu.test(t) ? 'week' : null;
  let budget = null;
  const bm = t.match(/(\d[\d\s]{1,6})\s*(?:грн|гривень|гривні|гривня|₴)/u) || t.match(/бюджет\D{0,20}(\d{2,5})/u);
  if (bm) { const n = parseInt(bm[1].replace(/\s/g, ''), 10); if (n >= 50 && n <= 100000) budget = n; }
  const clean = String(text).replace(/\s+/g, ' ').trim();
  const sentences = clean.split(/(?<=[.!?])\s+/).filter(Boolean);
  const question = trunc(sentences.find(s => s.endsWith('?')) || sentences[0] || clean, 180);
  return {
    ...cat,
    words: cat.primary ? wordsFor(text, [cat.primary, cat.secondary].filter(Boolean)) : [],
    urgency, budget, question,
    sensitive: SENSITIVE.test(t),
  };
}
function analyzeExpertise(text) {
  const cat = categorize(text);
  return { ...cat, tags: cat.primary ? wordsFor(text, [cat.primary, cat.secondary].filter(Boolean), 8) : [], sensitive: SENSITIVE.test(norm(text)) };
}

/* ===================== Фахівці, слоти, підбір ===================== */
const stemOf = w => (w.length > 5 ? w.slice(0, w.length - 2) : w);
function regToPublic(rec) {
  return {
    id: rec.id, name: rec.name, cat: rec.cat, level: rec.level, rating: null, reviews: 0, price: rec.price,
    position: rec.position, bio: trunc(rec.about, 200), focus: rec.tags.map(w => [stemOf(w), w]),
    days: rec.days, from: rec.from, to: rec.to, mock: false, verified: rec.status === 'approved', status: rec.status,
  };
}
const allExperts = () => [...MOCK_EXPERTS, ...db.experts.filter(e => e.status === 'approved').map(regToPublic)];
function findExpert(id) {
  const m = MOCK_EXPERTS.find(e => e.id === id); if (m) return m;
  const r = db.experts.find(e => e.id === id); return r ? regToPublic(r) : null;
}
const isBooked = (exId, date, time) => db.bookings.some(b => b.expertId === exId && b.date === date && b.time === time);
function slotsFor(ex) {
  const now = new Date(), nowMin = now.getHours() * 60 + now.getMinutes();
  const out = [];
  const horizon = ex.mock ? 3 : 7;
  for (let d = 0; d < horizon; d++) {
    const date = new Date(); date.setHours(0, 0, 0, 0); date.setDate(date.getDate() + d);
    const ds = localDate(date);
    let list;
    if (ex.mock) {
      const seed = parseInt(ex.id.slice(1), 10);
      list = MOCK_TIMES.filter((t, i) => (i + seed + d * 2) % 3 === 0);
    } else {
      const wd = (date.getDay() + 6) % 7; // Пн = 0
      list = [];
      if (ex.days.includes(wd)) for (let t = toMin(ex.from); t + 15 <= toMin(ex.to); t += 60) list.push(fromMin(t));
    }
    list = list.filter(t => !(d === 0 && toMin(t) <= nowMin + 30)).filter(t => !isBooked(ex.id, ds, t));
    if (ex.mock || list.length) out.push({ d, date: ds, label: labelFor(ds), times: list });
  }
  return out;
}
const nextSlot = ex => { for (const day of slotsFor(ex)) if (day.times.length) return { ...day, time: day.times[0] }; return null; };

function scoreExpert(ex, a, text) {
  const reasons = [];
  let s = ex.cat === a.primary ? 60 : ex.cat === a.secondary ? 40 : 15;
  if (ex.cat === a.primary) reasons.push({ ok: true, text: `Працює з темою «${catName(ex.cat)}»` });
  else if (ex.cat === a.secondary) reasons.push({ ok: true, text: `Суміжна тема: «${catName(ex.cat)}»` });
  const t = norm(text);
  const hits = unique(ex.focus.filter(([stem]) => stemRe(stem, 'iu').test(t)).map(([, label]) => label));
  if (hits.length) { s += Math.min(24, hits.length * 8); reasons.push({ ok: true, text: `Спеціалізація збігається: ${hits.join(', ')}` }); }
  const ns = nextSlot(ex);
  if (a.urgency === 'today') {
    if (ns && ns.d === 0) { s += 6; reasons.push({ ok: true, text: 'Є вільний час сьогодні' }); }
    else { s -= 4; reasons.push({ ok: false, text: 'Сьогодні вільного часу немає' }); }
  }
  if (a.budget) {
    if (ex.price <= a.budget) { s += 6; reasons.push({ ok: true, text: `Ціна в межах бюджету (до ${a.budget} грн)` }); }
    else { s -= 15; reasons.push({ ok: false, text: `Дорожче за ваш бюджет на ${ex.price - a.budget} грн` }); }
  }
  if (ex.rating >= 4.8) { s += 4; reasons.push({ ok: true, text: 'Високий рейтинг' }); }
  else if (ex.rating) s += (ex.rating - 4) * 4;
  return { match: Math.max(5, Math.min(98, Math.round(s))), reasons, nextSlot: ns };
}
function rankExperts(a) {
  return allExperts()
    .filter(ex => ex.id !== db.currentUserId && (ex.cat === a.primary || ex.cat === a.secondary))
    .map(ex => ({ ex, ...scoreExpert(ex, a, fullText()) }));
}
function expertCardHtml(ex, opts = {}) {
  const ns = opts.button ? (opts.nextSlot !== undefined ? opts.nextSlot : nextSlot(ex)) : null;
  return `<div class="card">
    <div class="row">
      <div><strong>${esc(ex.name)}</strong><span class="badge">${LEVELS[ex.level]}</span><span class="badge">${ex.verified ? '✓ перевірено' : 'на перевірці'}</span></div>
      <div>${opts.match != null ? `<span class="match">${opts.match}% збіг</span> · ` : ''}<strong>${ex.price} грн</strong> / 15 хв</div>
    </div>
    <p class="hint">${ex.rating ? `★ ${ex.rating} (${ex.reviews} відгуків)` : 'Новий фахівець, відгуків ще немає'}${ex.position ? ' · ' + esc(ex.position) : ''}</p>
    <p style="margin:4px 0">${esc(ex.bio)}</p>
    ${ex.focus.length ? `<p class="hint">Теми: ${unique(ex.focus.map(f => f[1])).map(esc).join(', ')}</p>` : ''}
    ${opts.reasons ? `<ul class="reasons" aria-label="Чому підходить">${opts.reasons.map(r => `<li class="${r.ok ? '' : 'minus'}">${r.ok ? '✓' : '✗'} ${esc(r.text)}</li>`).join('')}</ul>` : ''}
    ${opts.button ? `<div class="row"><span class="hint">Найближчий час: ${ns ? `${ns.label}, ${ns.time}` : 'немає вільних слотів'}</span><button class="small" data-id="${ex.id}">Обрати час</button></div>` : ''}
  </div>`;
}

/* ===================== Маршрутизація ===================== */
const ROUTES = [
  ['home', /^\/?$/], ['profile', /^\/(?:profile|signup)$/], ['login', /^\/login$/], ['ask', /^\/ask$/], ['analysis', /^\/analysis$/],
  ['expert', /^\/expert\/([\w-]+)$/], ['pay', /^\/pay$/], ['booked', /^\/booked\/([\w-]+)$/], ['session', /^\/session\/([\w-]+)$/],
  ['summary', /^\/summary\/([\w-]+)$/], ['thanks', /^\/thanks\/([\w-]+)$/], ['cabinet', /^\/cabinet$/],
  ['becomeExpert', /^\/become-expert$/], ['expertSent', /^\/expert-sent$/], ['results', /^\/results$/],
];
// Маршрут живе в адресі (#/…). Якщо середовище не дає змінити адресу (деякі вбудовані перегляди),
// перемикаємось на маршрут у пам'яті — сторінки при цьому працюють так само.
let memRoute = null;
const currentPath = () => (memRoute !== null ? memRoute : (location.hash.replace(/^#/, '') || '/'));
function setAddress(path, replace) {
  if (memRoute === null) {
    const target = '#' + path;
    if (location.hash === target) { render(); return; }
    try { navByApp = true; if (replace) location.replace(target); else location.hash = target; } catch { /* нижче перевіримо */ }
    if (location.hash === target) return; // адреса змінилась — далі спрацює hashchange
    navByApp = false;
    memRoute = path; // адресу змінити не можна — працюємо з пам'яті
    log('memory_routing');
  } else memRoute = path;
  render();
}
function parseHash() {
  const raw = currentPath();
  const [path, qs] = raw.split('?');
  for (const [name, re] of ROUTES) { const m = path.match(re); if (m) return { name, param: m[1], query: new URLSearchParams(qs || '') }; }
  return { name: 'notFound', query: new URLSearchParams() };
}
function nav(path) {
  if (currentPath() === path) { render(); return; }
  setAddress(path, false);
}
function redirect(path, notice) {
  if (notice) pendingNotice = notice;
  setAddress(path, true);
}
function goBack(path) { test.backs++; log('back', `${current} → ${path}`); nav(path); }
const safeNext = n => (['ask', 'cabinet', 'become-expert'].includes(n) ? n : '');

// Історія адрес, щоб відрізнити «назад» браузера від «вперед»
const visited = [location.hash || '#/'];
window.addEventListener('hashchange', () => {
  const h = location.hash || '#/';
  if (navByApp) visited.push(h);
  else if (visited[visited.length - 2] === h) {
    visited.pop();
    if (test.startedAt) { test.backs++; log('browser_back', h); }
  } else { visited.push(h); log('browser_forward', h); }
  navByApp = false;
  render();
});

const CLIENT_STEPS = ['Опис', 'Аналіз AI', 'Фахівець і час', 'Оплата', 'Консультація', 'Підсумок'];
const STEP_OF = { ask: 0, analysis: 1, expert: 2, pay: 3, booked: 3, session: 4, summary: 5, thanks: 6 };

function render(opts = {}) {
  const r = parseHash();
  const now = Date.now();
  const same = opts.silent && r.name === current;
  if (!same) {
    if (current) test.screenTimes[current] = (test.screenTimes[current] || 0) + (now - screenEnteredAt);
    current = r.name; screenEnteredAt = now;
    log('screen', r.name + (r.param ? ':' + r.param : ''));
  }
  clearInterval(screenInterval); screenInterval = null;
  renderToken++;
  const main = $('#main');
  main.innerHTML = (pendingNotice ? `<div class="notice" role="status">${esc(pendingNotice)}</div>` : '') + '<div id="page"></div>';
  pendingNotice = null;
  const page = $('#page');
  (PAGES[r.name] || PAGES.notFound)(page, r);
  renderNav(); renderSteps(); updatePanelStatic();
  if (!same) {
    window.scrollTo(0, 0);
    const h = page.querySelector('h1, h2');
    if (h) { h.tabIndex = -1; h.focus({ preventScroll: true }); }
  }
}
function renderNav() {
  const u = me();
  const isCur = n => (current === n ? 'aria-current="page"' : '');
  $('#nav').innerHTML = `
    <a href="#/ask" ${isCur('ask')}>Поставити питання</a>
    <a href="#/profile" ${isCur('profile')}>Мій профіль</a>
    <a href="#/become-expert" ${isCur('becomeExpert')}>Для фахівців</a>
    <a href="#/cabinet" id="cabLink" data-newtab ${isCur('cabinet')}>Кабінет ↗</a>
    ${u ? `<span class="hint">${esc(u.name)} · ${u.type === 'expert' ? 'фахівець' : 'клієнт'}</span><button class="small" id="logoutBtn" type="button">Вийти</button>`
        : `<a href="#/login" ${isCur('login')}>Увійти</a>`}`;
  $('#cabLink').onclick = e => { e.preventDefault(); openCabinet(); };
  if ($('#logoutBtn')) $('#logoutBtn').onclick = () => { logout(); nav('/'); };
}
function renderSteps() {
  const idx = STEP_OF[current];
  $('#stepsBar').hidden = idx === undefined;
  if (idx === undefined) return;
  $('#steps').innerHTML = CLIENT_STEPS.map((l, i) =>
    `<li class="${i < idx ? 'done' : i === idx ? 'current' : ''}" ${i === idx ? 'aria-current="step"' : ''}>${i + 1}. ${l}</li>`).join('');
}
function logout() { log('logout'); db.currentUserId = null; commit(); flow = freshFlow(); }
function openCabinet() {
  // Кабінет відкривається в новій вкладці; дані між вкладками спільні через localStorage
  const url = location.href.split('#')[0] + '#/cabinet';
  let w = null;
  try { w = window.open(url, '_blank'); } catch { w = null; }
  log('open_cabinet', w ? 'нова вкладка' : 'ця вкладка (нові вкладки заблоковані)');
  if (!w) {
    pendingNotice = 'Цей перегляд не дозволяє відкривати нові вкладки, тому кабінет відкрито тут. Відкрийте файл у браузері, і кабінет відкриватиметься в окремій вкладці.';
    nav('/cabinet');
  }
}

// Вбудований перегляд — iframe із sandbox без allow-forms: подія submit там не спрацьовує.
// Тому кнопки форм type="button", а Enter (і Ctrl+Enter у полі опису) обробляємо самі.
function bindSubmit(form, handler) {
  form.addEventListener('submit', e => e.preventDefault());
  form.querySelectorAll('[data-submit]').forEach(b => b.addEventListener('click', () => handler()));
  form.addEventListener('keydown', e => {
    if (e.key !== 'Enter' || e.isComposing) return;
    const single = e.target.matches('input[type=text], input[type=email], input[type=tel], input[type=password], input[type=number], input[type=url]');
    const ctrlInTextarea = e.target.matches('textarea') && (e.ctrlKey || e.metaKey);
    if (single || ctrlInTextarea) { e.preventDefault(); handler(); }
  });
}

/* ===================== Сторінки ===================== */
const PAGES = {};

PAGES.home = m => {
  const experts = allExperts();
  const active = CATEGORIES.filter(c => experts.some(e => e.cat === c.id));
  m.innerHTML = `
    <h1>Коротка консультація з потрібним фахівцем</h1>
    <p>10–15 хвилин розмови і конкретна відповідь. Без пошуку через знайомих і без оплати за цілу годину.</p>
    <div class="actions"><button class="primary" id="cta">Поставити питання</button><button id="ctaExpert">Я фахівець</button></div>
    <h2 style="margin-top:24px">Як це працює</h2>
    <ol class="how">
      <li><strong>Опишіть питання своїми словами.</strong> Без анкет і списків: просто розкажіть, що сталося.</li>
      <li><strong>AI підбере фахівців.</strong> Визначить тему і покаже, чому кожен фахівець вам підходить.</li>
      <li><strong>Оберіть час і оплатіть.</strong> Ціну встановлює фахівець, ви бачите її одразу.</li>
      <li><strong>Поговоріть 15 хвилин.</strong> Відеозв'язок у браузері, після розмови підсумок у кабінеті.</li>
    </ol>
    <div class="grid">
      <div class="card"><h3>Зараз на платформі</h3><p>${experts.length} перевірених фахівців у ${active.length} напрямах. Нові напрями з'являються разом із фахівцями.</p></div>
      <div class="card"><h3>Приватність</h3><p>Розмова не записується. Опис питання бачить лише обраний фахівець.</p></div>
      <div class="card"><h3>Для фахівців</h3><p>Заробляйте на коротких консультаціях без пошуку клієнтів. Ціну встановлюєте самі, комісія платформи 20%.</p><a href="#/become-expert">Стати фахівцем →</a></div>
    </div>
    <p class="hint" style="margin-top:12px">Медичні та психологічні консультації на першому етапі не проводимо.</p>`;
  $('#cta', m).onclick = () => { log('cta_ask'); nav('/ask'); };
  $('#ctaExpert', m).onclick = () => { log('cta_expert'); nav('/become-expert'); };
};

/* ---------- Мій профіль: окрема сторінка; дані з неї автоматично підставляються в заявку ---------- */
PAGES.profile = (m, r) => {
  const next = safeNext(r.query.get('next'));
  const u = me();
  const isNew = !u;
  const nextLabel = { ask: 'Зберегти і повернутися до заявки', cabinet: 'Зберегти і відкрити кабінет', 'become-expert': 'Зберегти і продовжити' }[next];
  m.innerHTML = `
    <h2>Мій профіль</h2>
    <p class="hint">${isNew
      ? 'Розкажіть коротко про себе. Ці дані автоматично підставлятимуться в кожну заявку, тож заповнити їх треба лише один раз.'
      : 'Ці дані автоматично підставляються в кожну вашу заявку.'}</p>
    ${next === 'ask' ? '<div class="notice">Вашу заявку збережено. Після заповнення профілю ви повернетеся до неї.</div>' : ''}
    <form id="f" novalidate>
      <label for="name">Як до вас звертатися?</label>
      <input id="name" type="text" autocomplete="given-name" value="${esc(u ? u.name : '')}">
      <div id="nameErr" class="error"></div>
      <label for="email">Електронна пошта</label>
      <input id="email" type="email" autocomplete="email" inputmode="email" value="${esc(u ? u.email : '')}">
      <p class="hint">Сюди прийдуть підтвердження бронювання і підсумок консультації.</p>
      <div id="emailErr" class="error"></div>
      <label for="about">Чим ви займаєтесь? <span class="hint">(необов'язково)</span></label>
      <input id="about" type="text" value="${esc(u && u.about ? u.about : '')}">
      <p class="hint">Допомагає AI точніше підібрати фахівця. Фахівець побачить це разом із заявкою.</p>
      ${isNew ? '<p class="hint">Зберігаючи профіль, ви погоджуєтесь з умовами користування. Вхід без пароля, за посиланням на пошту (у прототипі імітується).</p>' : ''}
      <div id="savedMsg" class="ok" hidden role="status">Профіль збережено ✓</div>
      <div class="actions"><button class="primary" type="button" data-submit>${nextLabel || 'Зберегти профіль'}</button></div>
    </form>
    ${isNew ? `<p>Вже заповнювали профіль раніше? <a href="#/login?next=${next}">Увійти</a></p>` : ''}`;
  bindSubmit($('#f', m), () => {
    const name = $('#name', m), email = $('#email', m);
    const nm = name.value.trim(), em = email.value.trim();
    const errs = [], first = [];
    if (!nm) { setErr('nameErr', 'Вкажіть, як до вас звертатися', name); errs.push('name'); first.push(name); } else setErr('nameErr', '', name);
    const taken = db.users.some(x => x.type === (u ? u.type : 'client') && x.id !== (u && u.id) && x.email.toLowerCase() === em.toLowerCase());
    if (!EMAIL_RE.test(em)) { setErr('emailErr', 'Перевірте адресу пошти', email); errs.push('email'); first.push(email); }
    else if (taken) { setErr('emailErr', 'Профіль з такою поштою вже є. Увійдіть за посиланням нижче.', email); errs.push('email_taken'); first.push(email); }
    else setErr('emailErr', '', email);
    if (errs.length) return fail(errs, first, 'профіль');
    const about = $('#about', m).value.trim();
    if (u) {
      Object.assign(u, { name: nm, email: em, about });
      const rec = myExpertRecord(); if (rec) Object.assign(rec, { name: nm, email: em });
      log('profile_updated');
    } else {
      const user = { id: uid('u'), type: 'client', name: nm, email: em, about, createdAt: Date.now() };
      db.users.push(user); db.currentUserId = user.id;
      log('profile_created');
    }
    commit();
    if (next) return nav('/' + next);
    renderNav();
    $('#savedMsg', m).hidden = false;
  });
};

PAGES.login = (m, r) => {
  const next = safeNext(r.query.get('next'));
  m.innerHTML = `
    <h2>Вхід</h2>
    <p class="hint">Вкажіть пошту, з якою реєструвалися. У прототипі вхід відбувається одразу, без листа.</p>
    <form id="f" novalidate>
      <label for="email">Електронна пошта</label>
      <input id="email" type="email" autocomplete="email">
      <div id="emailErr" class="error"></div>
      <div class="actions"><button class="primary" type="button" data-submit>Увійти</button></div>
    </form>
    <p>Ще не заповнювали профіль? <a href="#/profile?next=${next}">Заповнити профіль</a> або <a href="#/become-expert">стати фахівцем</a>.</p>`;
  bindSubmit($('#f', m), () => {
    const email = $('#email', m);
    const em = email.value.trim().toLowerCase();
    const u = db.users.find(x => x.email.toLowerCase() === em);
    if (!u) { setErr('emailErr', EMAIL_RE.test(em) ? 'Акаунт з такою поштою не знайдено' : 'Перевірте адресу пошти', email); return fail(['login'], [email], 'вхід'); }
    db.currentUserId = u.id; commit(); flow = freshFlow();
    log('login', u.type);
    nav('/' + next);
  });
};

PAGES.ask = m => {
  const u = me();
  // Дані про людину беруться з профілю автоматично
  const who = u
    ? `<div class="card" id="whoCard"><div class="row"><span><strong>Заявка від:</strong> ${esc(u.name)}</span><a href="#/profile">Змінити профіль</a></div>
        <p class="hint" style="margin:0">${esc(u.email)}${u.about ? ' · ' + esc(u.about) : ''}</p></div>`
    : '';
  m.innerHTML = `
    <h2>Опишіть своє питання</h2>
    ${who}
    <p class="hint">Своїми словами: що сталося і яку відповідь хочете отримати після розмови. Якщо це важливо, напишіть, коли потрібна консультація і який у вас бюджет.</p>
    <form id="f" novalidate>
      <label for="text">Ваше питання</label>
      <textarea id="text" maxlength="2000" rows="7">${esc(flow.draft != null ? flow.draft : fullText())}</textarea>
      <div class="row"><span id="textErr" class="error"></span><span class="hint" id="count"></span></div>
      <p class="hint">Опис побачить лише фахівець, якого ви оберете.</p>
      <div id="profileErr" class="error" role="alert"></div>
      <div class="actions"><button class="primary" type="button" data-submit>Знайти фахівця</button></div>
    </form>`;
  const form = $('#f', m), ta = $('#text', m), count = $('#count', m);
  const MIN = 30;
  const upd = () => { const n = ta.value.trim().length; count.textContent = n < MIN ? `${n} / ще ${MIN - n} симв.` : `${n} симв. ✓`; };
  upd();
  // Чернетка зберігається, щоб після заповнення профілю текст не загубився
  ta.addEventListener('input', () => { upd(); flow.draft = ta.value; });
  // Час опису стартує з першої взаємодії з полем, а не з входу на екран
  const markStart = e => { if (!test.formStartedAt && e.target === ta) { test.formStartedAt = Date.now(); log('form_start'); } };
  form.addEventListener('focusin', markStart);
  form.addEventListener('pointerdown', markStart);
  bindSubmit(form, () => {
    const v = ta.value.trim();
    if (v.length < MIN) { setErr('textErr', `Опишіть трохи детальніше: щонайменше ${MIN} символів`, ta); return fail(['text'], [ta], 'опис'); }
    setErr('textErr', '', ta);
    // Без профілю заявку не приймаємо: показуємо помилку з посиланням на профіль
    if (!me()) {
      flow.draft = ta.value;
      $('#profileErr', m).innerHTML = 'Ми не знаємо хто ви, <a href="#/profile?next=ask" id="profileLink">заповніть свій профіль</a>';
      return fail(['no_profile'], [$('#profileLink', m)], 'заявка');
    }
    $('#profileErr', m).textContent = '';
    if (!test.formStartedAt) test.formStartedAt = Date.now();
    if (v !== fullText()) { const ui = flow.ui; flow = freshFlow(); flow.ui = ui; flow.text = v; }
    flow.draft = null;
    if (test.requestSubmittedAt) { test.resubmits++; log('request_resubmitted'); }
    else { test.requestSubmittedAt = Date.now(); log('request_submitted', `заповнення ${fmt(test.requestSubmittedAt - test.formStartedAt)}`); }
    nav('/analysis');
  });
};

PAGES.analysis = m => {
  if (!me() || !flow.text) return redirect('/ask');
  const key = fullText() + '|' + flow.excluded.join(',');
  if (flow.analysis && flow.analysisKey === key) return showAnalysis(m);
  m.innerHTML = `<h2>Аналізуємо запит</h2><p role="status"><span class="spinner" aria-hidden="true"></span>AI читає ваш опис і шукає відповідних фахівців…</p>`;
  const token = renderToken;
  setTimeout(() => {
    if (token !== renderToken) return; // користувач уже пішов з екрана
    flow.analysis = analyzeRequest(fullText(), (me() || {}).about || '', flow.excluded);
    flow.analysisKey = key;
    flow.clarifyMode = null;
    test.aiRuns++;
    const a = flow.analysis;
    log('ai_analysis', `тема=${a.primary || '—'}${a.secondary ? '+' + a.secondary : ''}, впевненість ${a.confidence}%, коли=${a.urgency || '—'}, бюджет=${a.budget || '—'}${a.sensitive ? ', чутлива тема' : ''}`);
    showAnalysis(m);
    const h = m.querySelector('h2'); if (h) { h.tabIndex = -1; h.focus(); }
  }, 1100);
};

function showAnalysis(m) {
  const a = flow.analysis;

  // 1. Чутлива тема (медицина/психологія) — не консультуємо в першій версії
  if (a.sensitive && !flow.override) {
    log('sensitive_blocked');
    m.innerHTML = `
      <h2>Цю тему поки не консультуємо</h2>
      <div class="warn">AI помітив, що питання може стосуватися здоров'я або психологічного стану. На першому етапі таких консультацій немає: там інша відповідальність. Будь ласка, зверніться до лікаря або психолога напряму.</div>
      <div class="actions"><button id="edit">Змінити опис</button><button id="override">Питання не медичне, продовжити</button></div>`;
    $('#edit', m).onclick = () => goBack('/ask');
    $('#override', m).onclick = () => { flow.override = true; log('not_medical_override'); showAnalysis(m); };
    return;
  }

  // 2. AI не впевнений або користувач сказав, що AI помилився — уточнювальне питання (вільний текст)
  if (!a.primary || flow.clarifyMode) {
    const wrong = flow.clarifyMode === 'wrong';
    const msg = wrong
      ? 'Вибачте, що не влучив. Розкажіть, будь ласка, своїми словами, до якої сфери належить питання і хто, на вашу думку, міг би допомогти.'
      : 'Я не впевнений, до якого фахівця вас направити. Розкажіть, будь ласка, детальніше: що саме сталося, у якій сфері це питання і яку відповідь ви хочете отримати?';
    m.innerHTML = `
      <h2>Потрібно трохи більше деталей</h2>
      <div class="card"><p style="margin:0"><strong>AI:</strong> ${msg}</p></div>
      <form id="cf" novalidate>
        <label for="clar">Ваше уточнення</label>
        <textarea id="clar" rows="4" maxlength="1000"></textarea>
        <div id="clarErr" class="error"></div>
        <div class="actions"><button type="button" id="edit">Переписати опис повністю</button><button class="primary" type="button" data-submit>Надіслати уточнення</button></div>
      </form>`;
    $('#edit', m).onclick = () => goBack('/ask');
    bindSubmit($('#cf', m), () => {
      const ta = $('#clar', m), v = ta.value.trim();
      if (v.length < 10) { setErr('clarErr', 'Напишіть хоча б одне речення', ta); return fail(['clarification'], [ta], 'уточнення'); }
      if (wrong && a.primary) flow.excluded.push(a.primary);
      flow.clarifications.push(v);
      flow.analysis = null; flow.clarifyMode = null;
      test.clarifications++;
      log('ai_clarification', wrong ? 'після «AI помилився»' : 'AI не визначив тему');
      render({ silent: true });
    });
    return;
  }

  // 3. Результат: як AI зрозумів запит + підібрані фахівці
  const ranked = rankExperts(a);
  const primaryList = ranked.filter(x => x.ex.cat === a.primary);
  m.innerHTML = `
    <h2>Підібрані фахівці</h2>
    <div class="card">
      <h3 style="margin-top:0">Як AI зрозумів ваш запит</h3>
      <table>
        <tr><td>Тема</td><td>${esc(catName(a.primary))} <span class="hint">· впевненість ${a.confidence}%</span>${a.secondary ? `<br><span class="hint">Також стосується: ${esc(catName(a.secondary))}</span>` : ''}</td></tr>
        <tr><td>Головне питання</td><td>${esc(a.question)}</td></tr>
        ${a.words.length ? `<tr><td>Ключові слова</td><td>${a.words.map(esc).join(', ')}</td></tr>` : ''}
        <tr><td>Коли</td><td>${a.urgency ? URGENCY_LABEL[a.urgency] : 'Не вказано, показуємо найближчий час'}</td></tr>
        <tr><td>Бюджет</td><td>${a.budget ? `до ${a.budget} грн` : 'Не вказано'}</td></tr>
      </table>
      <div class="actions"><button class="small" id="edit">Змінити опис</button><button class="small" id="wrong">AI неправильно зрозумів тему</button></div>
    </div>
    ${primaryList.length ? '' : `
      <div class="warn" id="wait">
        Поки немає фахівців з теми «${esc(catName(a.primary))}». Ми саме шукаємо їх і можемо написати вам, щойно хтось з'явиться.
        <div class="actions" style="margin-top:8px"><button class="small" id="waitBtn" ${flow.waitlisted ? 'disabled' : ''}>${flow.waitlisted ? 'Ви в списку очікування ✓' : 'Повідомити мене'}</button></div>
      </div>`}
    ${ranked.length ? `
      <div>
        <label class="inline">Рівень
          <select id="lvl"><option value="">Усі</option>${Object.entries(LEVELS).map(([k, v]) => `<option value="${k}">${v}</option>`).join('')}</select>
        </label>
        <label class="inline">Сортувати
          <select id="sort"><option value="match">Найкращий збіг</option><option value="price">Спочатку дешевші</option><option value="rating">Найвищий рейтинг</option><option value="soon">Найближчий час</option></select>
        </label>
      </div>
      ${!primaryList.length ? '<p class="hint">Можуть допомогти із суміжної теми:</p>' : ''}
      <div id="list"></div>` : ''}`;
  $('#edit', m).onclick = () => goBack('/ask');
  $('#wrong', m).onclick = () => { test.aiWrong++; flow.clarifyMode = 'wrong'; log('ai_wrong_topic', a.primary); showAnalysis(m); };
  if ($('#waitBtn', m)) $('#waitBtn', m).onclick = e => { flow.waitlisted = true; log('waitlist', a.primary); e.target.disabled = true; e.target.textContent = 'Ви в списку очікування ✓'; };
  if (!ranked.length) return;

  const ui = flow.ui;
  $('#lvl', m).value = ui.lvl; $('#sort', m).value = ui.sort;
  const draw = () => {
    let list = ranked.filter(x => !ui.lvl || x.ex.level === ui.lvl);
    const soon = x => (x.nextSlot ? x.nextSlot.d * 1440 + toMin(x.nextSlot.time) : Infinity);
    const sorters = { match: (p, q) => q.match - p.match, price: (p, q) => p.ex.price - q.ex.price, rating: (p, q) => (q.ex.rating || 0) - (p.ex.rating || 0), soon: (p, q) => soon(p) - soon(q) };
    list = [...list].sort(sorters[ui.sort]);
    $('#list', m).innerHTML = list.length
      ? list.map(x => expertCardHtml(x.ex, { match: x.match, reasons: x.reasons, button: true, nextSlot: x.nextSlot })).join('')
      : '<p>Нікого не знайдено з таким фільтром.</p>';
    $('#list', m).querySelectorAll('button[data-id]').forEach(b => b.onclick = () => {
      if (flow.expertId !== b.dataset.id) flow.slot = null;
      flow.expertId = b.dataset.id;
      log('open_expert', b.dataset.id);
      nav('/expert/' + b.dataset.id);
    });
  };
  $('#lvl', m).onchange = () => { ui.lvl = $('#lvl', m).value; log('filter_level', ui.lvl || 'all'); draw(); };
  $('#sort', m).onchange = () => { ui.sort = $('#sort', m).value; log('sort', ui.sort); draw(); };
  draw();
}

PAGES.expert = (m, r) => {
  const ex = findExpert(r.param);
  if (!ex) return PAGES.notFound(m);
  if (!flow.analysis || !flow.analysis.primary) return redirect('/ask', 'Спершу опишіть питання, щоб ми показали, чи підходить фахівець.');
  const sc = scoreExpert(ex, flow.analysis, fullText());
  const days = slotsFor(ex);
  const reviews = ex.mock ? SAMPLE_REVIEWS[parseInt(ex.id.slice(1), 10) % SAMPLE_REVIEWS.length] : [];
  m.innerHTML = `
    <h2>${esc(ex.name)}</h2>
    <p><span class="badge">${LEVELS[ex.level]}</span><span class="badge">✓ перевірено</span> ${ex.rating ? `★ ${ex.rating} (${ex.reviews} відгуків)` : '<span class="hint">Новий фахівець</span>'}</p>
    ${ex.position ? `<p class="hint">${esc(ex.position)}</p>` : ''}
    <p>${esc(ex.bio)}</p>
    <p><strong>${ex.price} грн</strong> за 15 хвилин. Ціну встановлює фахівець.</p>
    <div class="card"><strong>Чому підходить (${sc.match}% збіг)</strong>
      <ul class="reasons">${sc.reasons.map(x => `<li class="${x.ok ? '' : 'minus'}">${x.ok ? '✓' : '✗'} ${esc(x.text)}</li>`).join('')}</ul>
    </div>
    <h3>Відгуки</h3>
    ${reviews.length ? reviews.map(t => `<div class="card hint">«${esc(t)}»</div>`).join('') : '<p class="hint">Відгуків поки немає.</p>'}
    <h3>Оберіть час</h3>
    <p class="hint">Час київський. Консультація 15 хвилин.</p>
    ${days.length ? days.map(day => `
      <div><strong>${esc(day.label)}</strong></div>
      <div class="slots">${day.times.length
        ? day.times.map(t => `<button type="button" class="slot small" data-date="${day.date}" data-t="${t}" aria-pressed="false">${t}</button>`).join('')
        : '<span class="hint">немає вільного часу</span>'}</div>`).join('') : '<p>Найближчого тижня вільного часу немає.</p>'}
    <div id="slotErr" class="error"></div>
    <div class="actions"><button id="back">Назад до підбору</button><button class="primary" id="next">Продовжити</button></div>`;
  $('#back', m).onclick = () => goBack('/analysis');
  const slotBtns = [...m.querySelectorAll('.slot')];
  if (flow.slot && flow.expertId === ex.id) {
    const sel = slotBtns.find(b => b.dataset.date === flow.slot.date && b.dataset.t === flow.slot.time);
    if (sel) sel.setAttribute('aria-pressed', 'true'); else flow.slot = null;
  }
  slotBtns.forEach(b => b.onclick = () => {
    slotBtns.forEach(x => x.setAttribute('aria-pressed', 'false'));
    b.setAttribute('aria-pressed', 'true');
    flow.expertId = ex.id;
    flow.slot = { date: b.dataset.date, time: b.dataset.t };
    setErr('slotErr', '');
    log('slot_selected', `${labelFor(b.dataset.date)} ${b.dataset.t}`);
  });
  $('#next', m).onclick = () => {
    if (!flow.slot || flow.expertId !== ex.id) { setErr('slotErr', 'Оберіть зручний час вище'); return fail(['slot'], [], 'вибір часу'); }
    nav('/pay');
  };
};

PAGES.pay = m => {
  const ex = flow.expertId && findExpert(flow.expertId);
  if (!me() || !ex || !flow.slot || !flow.analysis) return redirect('/ask');
  const a = flow.analysis;
  m.innerHTML = `
    <h2>Підтвердження і оплата</h2>
    <table>
      <tr><td>Фахівець</td><td>${esc(ex.name)} (${LEVELS[ex.level]})</td></tr>
      <tr><td>Коли</td><td>${esc(labelFor(flow.slot.date))}, ${flow.slot.time} · 15 хв · відеозв'язок у браузері</td></tr>
      <tr><td>Ваше питання</td><td>${esc(a.question)}</td></tr>
      <tr><td>До сплати</td><td><strong>${ex.price} грн</strong></td></tr>
    </table>
    <p class="hint">Фахівець побачить ваш опис ситуації до початку консультації.</p>
    <fieldset class="radio-col">
      <legend>Приватність</legend>
      <label><input type="checkbox" disabled> Записати сесію (з'явиться згодом, за окрему плату)</label>
      <p class="hint">Запис вимкнений. Зберігається лише короткий текстовий підсумок, який бачите ви.</p>
    </fieldset>
    <label class="inline" style="display:flex;gap:6px;align-items:flex-start;margin-top:12px">
      <input type="checkbox" id="agree">
      <span>Розумію, що консультація — це порада фахівця, а не офіційний висновок, і погоджуюсь з умовами користування.</span>
    </label>
    <a href="#" id="terms" aria-expanded="false" aria-controls="termsText">Прочитати умови</a>
    <div id="termsText" class="card hint" hidden>Фахівець відповідає за зміст консультації, платформа — за підбір, оплату і зв'язок. Рішення ухвалює клієнт. Якщо консультація не відбулася з вини фахівця, гроші повертаються.</div>
    <div id="agreeErr" class="error"></div>
    <div class="actions"><button id="back">Змінити час</button><button class="primary" id="payBtn">Оплатити ${ex.price} грн</button></div>
    <p class="hint">Прототип: оплата імітується, дані картки не запитуються.</p>`;
  $('#back', m).onclick = () => goBack('/expert/' + ex.id);
  $('#terms', m).onclick = e => {
    e.preventDefault();
    const box = $('#termsText', m); box.hidden = !box.hidden;
    e.target.setAttribute('aria-expanded', String(!box.hidden));
    if (!box.hidden) log('open_terms');
  };
  $('#agree', m).onchange = e => { if (e.target.checked) setErr('agreeErr', ''); };
  $('#payBtn', m).onclick = () => {
    if (!$('#agree', m).checked) { setErr('agreeErr', 'Позначте згоду з умовами, щоб продовжити'); return fail(['agree'], [$('#agree', m)], 'оплата'); }
    if (isBooked(ex.id, flow.slot.date, flow.slot.time)) {
      flow.slot = null; pendingNotice = 'Цей час щойно зайняли. Оберіть, будь ласка, інший.';
      log('slot_taken'); return nav('/expert/' + ex.id);
    }
    const btn = $('#payBtn', m);
    btn.disabled = true; btn.textContent = 'Обробка оплати…';
    $('#back', m).disabled = true; $('#agree', m).disabled = true;
    log('pay_click');
    const token = renderToken;
    setTimeout(() => {
      if (token !== renderToken) return;
      const u = me();
      const b = {
        id: uid('b'), clientId: u.id, clientName: u.name, expertId: ex.id, expertName: ex.name, expertMock: !!ex.mock,
        price: ex.price, date: flow.slot.date, time: flow.slot.time, status: 'booked', createdAt: Date.now(),
        request: { text: fullText(), question: a.question, cat: a.primary },
      };
      db.bookings.push(b); commit();
      if (!test.bookedAt) test.bookedAt = Date.now();
      log('booked', `від запиту до бронювання ${fmt(test.bookedAt - test.requestSubmittedAt)}`);
      flow = freshFlow();
      redirect('/booked/' + b.id);
    }, 900);
  };
};

const myBooking = id => db.bookings.find(b => b.id === id && b.clientId === db.currentUserId) || null;

PAGES.booked = (m, r) => {
  const b = myBooking(r.param); if (!b) return PAGES.notFound(m);
  m.innerHTML = `
    <h2>Заброньовано ✓</h2>
    <div class="ok">${esc(b.clientName)}, ви записані до <strong>${esc(b.expertName)}</strong>: ${esc(labelFor(b.date))}, ${b.time}.</div>
    <p>Консультація з'явилася у вашому кабінеті. Посилання на відеозв'язок відкриється там за 5 хвилин до початку, нагадування прийде на пошту (імітація).</p>
    <div class="actions">
      <button id="cab">Відкрити кабінет ↗</button>
      <button id="cal">Додати в календар</button>
      <button class="primary" id="join">Перейти до консультації</button>
    </div>
    <p class="hint">Прототип: перехід до сесії доступний одразу.</p>`;
  $('#cab', m).onclick = openCabinet;
  $('#cal', m).onclick = e => { log('add_to_calendar'); e.target.textContent = 'Додано ✓'; e.target.disabled = true; };
  $('#join', m).onclick = () => nav('/session/' + b.id);
};

PAGES.session = (m, r) => {
  const b = myBooking(r.param); if (!b) return PAGES.notFound(m);
  if (b.status === 'done') return redirect('/summary/' + b.id);
  const started = Date.now();
  m.innerHTML = `
    <h2>Консультація</h2>
    <div class="video">
      <div>📹 ${esc(b.expertName)}</div>
      <div id="timer">0:00 / 15:00</div>
      <div class="hint" style="color:#aaa">Імітація відеозв'язку · запис вимкнено</div>
    </div>
    <div class="card"><strong>Ваше питання:</strong> ${esc(b.request.question)}</div>
    <div class="actions"><button id="mic" aria-pressed="false">Вимкнути мікрофон</button><button class="primary" id="end">Завершити консультацію</button></div>
    <div id="endAsk" class="warn" hidden>
      Завершити консультацію зараз?
      <div class="actions" style="margin-top:8px"><button class="primary" id="endConfirm">Так, завершити</button><button id="endCancel">Продовжити розмову</button></div>
    </div>`;
  screenInterval = setInterval(() => { const el = $('#timer', m); if (el) el.textContent = `${fmt(Date.now() - started)} / 15:00`; }, 1000);
  $('#mic', m).onclick = e => {
    const off = e.target.getAttribute('aria-pressed') !== 'true';
    e.target.setAttribute('aria-pressed', String(off));
    e.target.textContent = off ? 'Увімкнути мікрофон' : 'Вимкнути мікрофон';
    log('mic', off ? 'off' : 'on');
  };
  // Підтвердження на сторінці: confirm() у вбудованому перегляді заблокований
  $('#end', m).onclick = () => { $('#endAsk', m).hidden = false; $('#endConfirm', m).focus(); log('end_ask'); };
  $('#endCancel', m).onclick = () => { $('#endAsk', m).hidden = true; log('end_cancel'); };
  $('#endConfirm', m).onclick = () => {
    b.status = 'done'; b.endedAt = Date.now();
    // Демо-фахівці «пишуть» підсумок одразу; справжні — у своєму кабінеті
    if (b.expertMock && !b.summaryText) b.summaryText = (SUMMARY_POINTS[b.request.cat] || ['Розібрали ситуацію.', 'Визначили наступні кроки.']).join('\n');
    commit(); log('session_end');
    nav('/summary/' + b.id);
  };
};

PAGES.summary = (m, r) => {
  const b = myBooking(r.param); if (!b) return PAGES.notFound(m);
  if (b.status !== 'done') return redirect('/session/' + b.id);
  const summaryHtml = b.summaryText
    ? `<ul>${b.summaryText.split('\n').filter(Boolean).map(p => `<li>${esc(p)}</li>`).join('')}</ul>`
    : '<p class="hint">Фахівець ще готує підсумок. Він з\'явиться у вашому кабінеті, а ми надішлемо лист.</p>';
  m.innerHTML = `
    <h2>Підсумок консультації</h2>
    <div class="card">
      <p><strong>Ваше питання:</strong> ${esc(b.request.question)}</p>
      <p><strong>Від ${esc(b.expertName)}:</strong></p>
      ${summaryHtml}
      <p class="hint">Підсумок бачите лише ви. Він зберігається в кабінеті.</p>
    </div>
    ${b.review ? `<div class="ok">Ваш відгук: ${'★'.repeat(b.review.rating)} · питання закрите: ${RESOLVED[b.review.resolved]}</div>
      <div class="actions"><button class="primary" id="done">Готово</button></div>` : `
    <h3>Як пройшла консультація?</h3>
    <fieldset><legend>Оцінка</legend>
      <div class="slots">${[1, 2, 3, 4, 5].map(n => `<button type="button" class="star small" data-n="${n}" aria-pressed="false" aria-label="${n} з 5">${'★'.repeat(n)}</button>`).join('')}</div>
    </fieldset>
    <div id="rateErr" class="error"></div>
    <fieldset class="radio-row"><legend>Ваше питання закрите?</legend>
      <label><input type="radio" name="resolved" value="yes"> Так</label>
      <label><input type="radio" name="resolved" value="partly"> Частково</label>
      <label><input type="radio" name="resolved" value="no"> Ні</label>
    </fieldset>
    <div id="resErr" class="error"></div>
    <label for="comment">Коментар (необов'язково)</label>
    <textarea id="comment" maxlength="500" style="min-height:70px"></textarea>
    <div class="actions"><button class="primary" id="send">Надіслати відгук</button><button id="skip">Пропустити</button></div>`}`;
  if (b.review) { $('#done', m).onclick = () => nav('/thanks/' + b.id); return; }
  let rating = 0;
  m.querySelectorAll('.star').forEach(btn => btn.onclick = () => {
    m.querySelectorAll('.star').forEach(x => x.setAttribute('aria-pressed', 'false'));
    btn.setAttribute('aria-pressed', 'true'); rating = +btn.dataset.n; setErr('rateErr', '');
  });
  $('#send', m).onclick = () => {
    const res = (m.querySelector('input[name=resolved]:checked') || {}).value;
    const errs = [];
    if (!rating) { setErr('rateErr', 'Поставте оцінку'); errs.push('rating'); }
    if (!res) { setErr('resErr', 'Оберіть варіант'); errs.push('resolved'); } else setErr('resErr', '');
    if (errs.length) return fail(errs, [], 'відгук');
    b.review = { rating, resolved: res, comment: $('#comment', m).value.trim() };
    commit();
    log('review_sent', `${rating}★, закрито: ${RESOLVED[res]}`);
    if (!test.finishedAt) test.finishedAt = Date.now();
    nav('/thanks/' + b.id);
  };
  $('#skip', m).onclick = () => { log('review_skipped'); if (!test.finishedAt) test.finishedAt = Date.now(); nav('/thanks/' + b.id); };
};

PAGES.thanks = (m, r) => {
  const b = myBooking(r.param); if (!b) return PAGES.notFound(m);
  m.innerHTML = `
    <h2>Дякуємо!</h2>
    <p>Консультація і підсумок збережені у вашому кабінеті.</p>
    <div class="actions"><button class="primary" id="newQ">Поставити нове питання</button><button id="cab">Мій кабінет ↗</button></div>`;
  $('#newQ', m).onclick = () => { flow = freshFlow(); nav('/ask'); };
  $('#cab', m).onclick = openCabinet;
};

/* ---------- Кабінет (відкривається в окремій вкладці) ---------- */
PAGES.cabinet = m => {
  const u = me();
  if (!u) {
    m.innerHTML = `<h2>Кабінет</h2><p>Увійдіть або заповніть профіль, щоб бачити свої консультації.</p>
      <div class="actions"><button class="primary" id="login">Увійти</button><button id="signup">Заповнити профіль</button></div>`;
    $('#login', m).onclick = () => nav('/login?next=cabinet');
    $('#signup', m).onclick = () => nav('/profile?next=cabinet');
    return;
  }
  if (u.type === 'expert') return expertCabinet(m, u);
  clientCabinet(m, u);
};

function bookingRow(b, side) {
  const who = side === 'client' ? b.expertName : b.clientName;
  return `<div class="card" data-bid="${b.id}">
    <div class="row"><strong>${esc(who)}</strong><span>${esc(labelFor(b.date))}, ${b.time} · ${b.price} грн</span></div>
    <p style="margin:4px 0">${esc(b.request.question)}</p>`;
}
function clientCabinet(m, u) {
  const mine = db.bookings.filter(b => b.clientId === u.id).sort((x, y) => (x.date + x.time).localeCompare(y.date + y.time));
  const upcoming = mine.filter(b => b.status === 'booked');
  const past = mine.filter(b => b.status === 'done').reverse();
  m.innerHTML = `
    <h2>Мій кабінет</h2>
    <div class="card"><div class="row"><strong>${esc(u.name)}</strong><a href="#/profile">Змінити профіль</a></div><span class="hint">${esc(u.email)}${u.about ? ' · ' + esc(u.about) : ''}</span></div>
    <div class="actions"><button class="primary" id="newQ">Поставити нове питання</button></div>
    <h3>Найближчі консультації</h3>
    ${upcoming.length ? upcoming.map(b => bookingRow(b, 'client') + `
      <div class="actions" style="margin-top:6px"><button class="small" data-join="${b.id}">Приєднатися</button></div></div>`).join('') : '<p class="hint">Поки немає запланованих консультацій.</p>'}
    <h3>Минулі консультації</h3>
    ${past.length ? past.map(b => bookingRow(b, 'client') + `
      ${b.summaryText ? `<details><summary>Підсумок</summary><ul>${b.summaryText.split('\n').filter(Boolean).map(p => `<li>${esc(p)}</li>`).join('')}</ul></details>` : '<p class="hint">Фахівець ще готує підсумок.</p>'}
      ${b.review ? `<p class="hint">Ваша оцінка: ${'★'.repeat(b.review.rating)}</p>` : `<div class="actions" style="margin-top:6px"><button class="small" data-rate="${b.id}">Оцінити</button></div>`}
      </div>`).join('') : '<p class="hint">Тут з\'являться проведені консультації та їхні підсумки.</p>'}`;
  $('#newQ', m).onclick = () => { flow = freshFlow(); nav('/ask'); };
  m.querySelectorAll('[data-join]').forEach(b => b.onclick = () => nav('/session/' + b.dataset.join));
  m.querySelectorAll('[data-rate]').forEach(b => b.onclick = () => nav('/summary/' + b.dataset.rate));
}
function expertCabinet(m, u) {
  const rec = myExpertRecord();
  if (!rec) { m.innerHTML = '<h2>Кабінет фахівця</h2><p>Анкету не знайдено.</p>'; return; }
  const pub = regToPublic(rec);
  const mine = db.bookings.filter(b => b.expertId === rec.id).sort((x, y) => (x.date + x.time).localeCompare(y.date + y.time));
  const upcoming = mine.filter(b => b.status === 'booked');
  const done = mine.filter(b => b.status === 'done').reverse();
  const gross = done.reduce((s, b) => s + b.price, 0);
  m.innerHTML = `
    <h2>Кабінет фахівця</h2>
    ${rec.status === 'pending'
      ? '<div class="warn">Заявка на перевірці. Зазвичай це 1–2 робочі дні. Після схвалення профіль з\'явиться в підборі для клієнтів.</div>'
      : '<div class="ok">Профіль активний: клієнти бачать вас у підборі.</div>'}
    <h3>Як вас бачать клієнти</h3>
    ${expertCardHtml(pub)}
    <h3>Графік</h3>
    <p>${rec.days.map(d => WEEKDAYS[d]).join(', ')}, ${rec.from}–${rec.to} · ${rec.price} грн за 15 хв</p>
    <h3>Найближчі консультації</h3>
    ${upcoming.length ? upcoming.map(b => bookingRow(b, 'expert') + `
      <details><summary>Опис від клієнта</summary><p style="white-space:pre-wrap">${esc(b.request.text)}</p></details>
      <p class="hint">Посилання на відеозв'язок з'явиться тут за 5 хвилин до початку.</p></div>`).join('') : '<p class="hint">Поки немає бронювань.</p>'}
    <h3>Проведені консультації</h3>
    ${done.length ? done.map(b => bookingRow(b, 'expert') + (b.summaryText
      ? `<details><summary>Ваш підсумок</summary><p style="white-space:pre-wrap">${esc(b.summaryText)}</p></details>`
      : `<label for="sum_${b.id}">Підсумок для клієнта</label>
         <p class="hint">Кілька пунктів: що обговорили і які наступні кроки. Кожен пункт з нового рядка.</p>
         <textarea id="sum_${b.id}" rows="4"></textarea><div id="sumErr_${b.id}" class="error"></div>
         <div class="actions" style="margin-top:6px"><button class="small" data-sum="${b.id}">Надіслати підсумок</button></div>`) +
      `${b.review ? `<p class="hint">Оцінка клієнта: ${'★'.repeat(b.review.rating)}</p>` : ''}</div>`).join('') : '<p class="hint">Тут з\'являться проведені консультації.</p>'}
    <h3>Заробіток</h3>
    <table>
      <tr><td>Проведено консультацій</td><td>${done.length}</td></tr>
      <tr><td>Оплачено клієнтами</td><td>${gross} грн</td></tr>
      <tr><td>Комісія платформи (20%)</td><td>${Math.round(gross * COMMISSION)} грн</td></tr>
      <tr><td>До виплати вам</td><td><strong>${Math.round(gross * (1 - COMMISSION))} грн</strong></td></tr>
    </table>`;
  m.querySelectorAll('[data-sum]').forEach(btn => btn.onclick = () => {
    const id = btn.dataset.sum, ta = $('#sum_' + id, m), v = ta.value.trim();
    if (v.length < 20) { setErr('sumErr_' + id, 'Напишіть хоча б кілька речень', ta); return fail(['summary'], [ta], 'підсумок фахівця'); }
    const b = db.bookings.find(x => x.id === id); b.summaryText = v; b.summaryAt = Date.now(); commit();
    log('expert_summary');
    render({ silent: true });
  });
}

/* ---------- Реєстрація фахівця: 5 кроків ---------- */
const EXPERT_STEPS = ['Обліковий запис', 'Експертиза', 'Кваліфікація і перевірка', 'Ціна і графік', 'Підтвердження'];
const MAX_FILE = 10 * 1024 * 1024;
const fileSize = n => (n > 1024 * 1024 ? (n / 1024 / 1024).toFixed(1) + ' МБ' : Math.max(1, Math.round(n / 1024)) + ' КБ');

PAGES.becomeExpert = m => {
  const u = me();
  if (u && u.type === 'expert') {
    m.innerHTML = `<h2>Ви вже зареєстровані як фахівець</h2><div class="actions"><button class="primary" id="cab">Відкрити кабінет ↗</button></div>`;
    $('#cab', m).onclick = openCabinet;
    return;
  }
  if (!db.expertDraft) {
    db.expertDraft = { step: 1, name: (u && u.name) || '', email: (u && u.email) || '', phone: '', passOk: false, about: '', position: '', years: '',
      cat: null, secondary: null, tags: [], education: '', qualFiles: [], idFile: null, link: '', price: '', days: [0, 1, 2, 3, 4], from: '10:00', to: '18:00' };
    commit();
  }
  renderWizard(m);
};

function renderWizard(m) {
  const d = db.expertDraft, step = d.step;
  m.innerHTML = `
    <h2>Реєстрація фахівця</h2>
    <p class="hint">Кожну заявку перевіряють вручну, тому клієнти можуть довіряти профілям. Займе 5–7 хвилин, чернетка зберігається автоматично.</p>
    <ol class="wsteps">${EXPERT_STEPS.map((s, i) => `<li class="${i + 1 < step ? 'done' : i + 1 === step ? 'current' : ''}" ${i + 1 === step ? 'aria-current="step"' : ''}>${i + 1}. ${s}</li>`).join('')}</ol>
    <h3>Крок ${step} з ${EXPERT_STEPS.length}: ${EXPERT_STEPS[step - 1]}</h3>
    <form id="wf" novalidate>
      ${WIZ[step].html(d)}
      <div class="actions">
        ${step > 1 ? '<button type="button" id="wBack">Назад</button>' : ''}
        <button type="button" class="primary" data-submit>${step < EXPERT_STEPS.length ? 'Далі' : 'Надіслати на перевірку'}</button>
      </div>
    </form>`;
  const form = $('#wf', m);
  form.addEventListener('focusin', () => { if (!test.expertStartedAt) { test.expertStartedAt = Date.now(); log('expert_signup_start'); } });
  if (WIZ[step].bind) WIZ[step].bind(m, d);
  bindSubmit(form, () => {
    const res = WIZ[step].validate(m, d); // збирає значення в чернетку і повертає [помилки, поля]
    commit();
    if (res.errs.length) {
      test.expertStepErrors[step] = (test.expertStepErrors[step] || 0) + res.errs.length;
      return fail(res.errs, res.first, `фахівець, крок ${step}`);
    }
    if (step < EXPERT_STEPS.length) {
      d.step++; commit(); log('expert_step', `${step} → ${d.step}`);
      renderWizard(m);
      const h = m.querySelector('h3'); if (h) { h.tabIndex = -1; h.focus(); }
    } else submitExpert(d);
  });
  if ($('#wBack', m)) $('#wBack', m).onclick = () => {
    if (WIZ[step].collect) WIZ[step].collect(m, d);
    d.step--; commit();
    test.backs++; log('back', `фахівець, крок ${step} → ${step - 1}`);
    renderWizard(m);
  };
}

const val = (m, id) => ($('#' + id, m) ? $('#' + id, m).value.trim() : '');
function check(cond, id, msg, m, res, field) {
  const f = field || $('#' + id, m);
  setErr(id + 'Err', cond ? '' : msg, f);
  if (!cond) { res.errs.push(id); res.first.push(f); }
}

const WIZ = {
  1: {
    html: d => `
      <label for="w_name">Прізвище та ім'я</label>
      <input id="w_name" type="text" autocomplete="name" value="${esc(d.name)}"><div id="w_nameErr" class="error"></div>
      <label for="w_email">Робоча пошта</label>
      <input id="w_email" type="email" autocomplete="email" value="${esc(d.email)}"><div id="w_emailErr" class="error"></div>
      <label for="w_phone">Телефон</label>
      <input id="w_phone" type="tel" autocomplete="tel" value="${esc(d.phone)}">
      <p class="hint">Український номер. Потрібен для зв'язку щодо перевірки, клієнти його не бачать.</p><div id="w_phoneErr" class="error"></div>
      <label for="w_pass">Пароль</label>
      <input id="w_pass" type="password" autocomplete="new-password">
      <p class="hint">Щонайменше 8 символів, літери й цифри.${d.passOk ? ' Пароль уже задано, повторно вводити не обов\'язково.' : ''}</p><div id="w_passErr" class="error"></div>
      <label for="w_pass2">Повторіть пароль</label>
      <input id="w_pass2" type="password" autocomplete="new-password"><div id="w_pass2Err" class="error"></div>`,
    collect(m, d) { d.name = val(m, 'w_name'); d.email = val(m, 'w_email'); d.phone = val(m, 'w_phone'); },
    validate(m, d) {
      this.collect(m, d);
      const res = { errs: [], first: [] };
      check(/^[\p{L}'’ʼ-]{2,}(\s+[\p{L}'’ʼ-]{2,})+$/u.test(d.name), 'w_name', 'Вкажіть прізвище та ім\'я повністю', m, res);
      const taken = db.users.some(u => u.type === 'expert' && u.email.toLowerCase() === d.email.toLowerCase());
      check(EMAIL_RE.test(d.email) && !taken, 'w_email', taken ? 'Фахівець з такою поштою вже зареєстрований' : 'Перевірте адресу пошти', m, res);
      check(/^(\+?380|0)\d{9}$/.test(d.phone.replace(/[\s()-]/g, '')), 'w_phone', 'Вкажіть номер у форматі +380XXXXXXXXX або 0XXXXXXXXX', m, res);
      const p1 = $('#w_pass', m).value, p2 = $('#w_pass2', m).value;
      if (p1 || !d.passOk) {
        const strong = p1.length >= 8 && /\p{L}/u.test(p1) && /\d/.test(p1);
        check(strong, 'w_pass', 'Пароль має містити щонайменше 8 символів, літери й цифри', m, res);
        if (strong) { check(p1 === p2, 'w_pass2', 'Паролі не збігаються', m, res); if (p1 === p2) d.passOk = true; }
      }
      return res; // сам пароль у сховищі не зберігаємо
    },
  },
  2: {
    html: d => `
      <label for="w_about">Опишіть свою експертизу</label>
      <p class="hint">Своїми словами: у чому ви фахівець, з якими питаннями до вас звертаються і чим можете допомогти за 15 хвилин. AI визначить напрям і ключові теми.</p>
      <textarea id="w_about" rows="6" maxlength="2000">${esc(d.about)}</textarea>
      <div class="row"><span id="w_aboutErr" class="error"></span><span class="hint" id="w_aboutCount"></span></div>
      <label for="w_position">Посада і місце роботи</label>
      <input id="w_position" type="text" value="${esc(d.position)}"><div id="w_positionErr" class="error"></div>
      <label for="w_years">Досвід у цій сфері, років</label>
      <input id="w_years" class="short" type="number" min="0" max="60" step="1" inputmode="numeric" value="${esc(d.years)}"><div id="w_yearsErr" class="error"></div>`,
    bind(m) {
      const ta = $('#w_about', m), c = $('#w_aboutCount', m);
      const upd = () => { const n = ta.value.trim().length; c.textContent = n < 80 ? `${n} / ще ${80 - n} симв.` : `${n} симв. ✓`; };
      upd(); ta.addEventListener('input', upd);
    },
    collect(m, d) { d.about = val(m, 'w_about'); d.position = val(m, 'w_position'); d.years = val(m, 'w_years'); },
    validate(m, d) {
      this.collect(m, d);
      const res = { errs: [], first: [] };
      const yrs = Number(d.years);
      check(d.about.length >= 80, 'w_about', 'Опишіть детальніше: щонайменше 80 символів', m, res);
      check(d.position.length >= 3, 'w_position', 'Вкажіть посаду і місце роботи', m, res);
      check(d.years !== '' && Number.isInteger(yrs) && yrs >= 0 && yrs <= 60, 'w_years', 'Вкажіть ціле число років від 0 до 60', m, res);
      if (res.errs.includes('w_about')) return res;
      const ea = analyzeExpertise(d.about + ' ' + d.position);
      log('ai_expertise', `напрям=${ea.primary || '—'}, теги=${ea.tags.join(', ') || '—'}`);
      if (ea.sensitive) check(false, 'w_about', 'Медичні та психологічні консультації на першому етапі не підключені', m, res);
      else if (!ea.primary) check(false, 'w_about', 'AI не зміг визначити напрям. Напишіть конкретніше, з якими задачами ви допомагаєте клієнтам.', m, res);
      else { d.cat = ea.primary; d.secondary = ea.secondary; d.tags = ea.tags; }
      return res;
    },
  },
  3: {
    html: d => `
      <div class="card"><strong>AI визначив напрям:</strong> ${esc(catName(d.cat))}${d.secondary ? ` <span class="hint">(також ${esc(catName(d.secondary))})</span>` : ''}
        <br><span class="hint">Ключові теми: ${d.tags.map(esc).join(', ') || '—'}. Не той напрям? Поверніться на крок назад і уточніть опис.</span></div>
      <label for="w_edu">Освіта</label>
      <input id="w_edu" type="text" value="${esc(d.education)}"><div id="w_eduErr" class="error"></div>
      <label for="w_qual">Документи про кваліфікацію</label>
      <p class="hint">Диплом, сертифікати, ліцензія чи свідоцтво. PDF, JPG або PNG, до 10 МБ кожен.</p>
      <input id="w_qual" type="file" multiple accept=".pdf,.jpg,.jpeg,.png">
      <ul class="files" id="w_qualList"></ul><div id="w_qualErr" class="error"></div>
      <label for="w_id">Документ, що посвідчує особу</label>
      <p class="hint">Потрібен лише для перевірки. Клієнти його не бачать.</p>
      <input id="w_id" type="file" accept=".pdf,.jpg,.jpeg,.png">
      <ul class="files" id="w_idList"></ul><div id="w_idErr" class="error"></div>
      <label for="w_link">Профіль або портфоліо <span class="hint">(необов'язково)</span></label>
      <input id="w_link" type="url" value="${esc(d.link)}"><div id="w_linkErr" class="error"></div>
      <p class="hint">У прототипі файли нікуди не надсилаються: зберігаються лише їхні назви.</p>`,
    bind(m, d) {
      const draw = () => {
        $('#w_qualList', m).innerHTML = d.qualFiles.map((f, i) => `<li>📄 ${esc(f.name)} <span class="hint">${fileSize(f.size)}</span><button type="button" class="small" data-rmq="${i}">Прибрати</button></li>`).join('');
        $('#w_idList', m).innerHTML = d.idFile ? `<li>🪪 ${esc(d.idFile.name)} <span class="hint">${fileSize(d.idFile.size)}</span><button type="button" class="small" data-rmid>Прибрати</button></li>` : '';
        m.querySelectorAll('[data-rmq]').forEach(b => b.onclick = () => { d.qualFiles.splice(+b.dataset.rmq, 1); commit(); draw(); });
        const rid = m.querySelector('[data-rmid]'); if (rid) rid.onclick = () => { d.idFile = null; commit(); draw(); };
      };
      const okType = f => /\.(pdf|jpe?g|png)$/i.test(f.name);
      $('#w_qual', m).onchange = e => {
        const bad = [];
        for (const f of e.target.files) {
          if (!okType(f)) bad.push(`${f.name}: непідтримуваний формат`);
          else if (f.size > MAX_FILE) bad.push(`${f.name}: більше 10 МБ`);
          else if (!d.qualFiles.some(x => x.name === f.name)) d.qualFiles.push({ name: f.name, size: f.size });
        }
        setErr('w_qualErr', bad.join('; '));
        if (bad.length) { test.errors += bad.length; log('validation', 'файли: ' + bad.join('; ')); }
        e.target.value = ''; commit(); draw();
      };
      $('#w_id', m).onchange = e => {
        const f = e.target.files[0]; if (!f) return;
        if (!okType(f) || f.size > MAX_FILE) { setErr('w_idErr', !okType(f) ? 'Непідтримуваний формат' : 'Файл більший за 10 МБ'); test.errors++; }
        else { d.idFile = { name: f.name, size: f.size }; setErr('w_idErr', ''); }
        e.target.value = ''; commit(); draw();
      };
      draw();
    },
    collect(m, d) { d.education = val(m, 'w_edu'); d.link = val(m, 'w_link'); },
    validate(m, d) {
      this.collect(m, d);
      const res = { errs: [], first: [] };
      check(d.education.length >= 3, 'w_edu', 'Вкажіть освіту', m, res);
      check(d.qualFiles.length > 0, 'w_qual', 'Додайте хоча б один документ про кваліфікацію', m, res);
      check(!!d.idFile, 'w_id', 'Додайте документ, що посвідчує особу', m, res);
      check(!d.link || /^https?:\/\/[^\s.]+\.\S+$/i.test(d.link), 'w_link', 'Посилання має починатися з http:// або https://', m, res);
      return res;
    },
  },
  4: {
    html: d => {
      const level = levelFor(d.years), [lo, hi] = LEVEL_PRICE[level];
      return `
      <div class="card">Попередній рівень: <strong>${LEVELS[level]}</strong> (досвід ${esc(d.years)} р.). Остаточно рівень підтверджується після перевірки.</div>
      <label for="w_price">Ціна консультації 15 хвилин, грн</label>
      <p class="hint">Рекомендований діапазон для вашого рівня: ${lo}–${hi} грн. Ціну встановлюєте ви. Комісія платформи 20%, ви отримаєте <strong id="w_net">—</strong>.</p>
      <input id="w_price" class="short" type="number" min="50" max="5000" step="10" inputmode="numeric" value="${esc(d.price)}">
      <div id="w_priceWarn" class="warn" hidden></div><div id="w_priceErr" class="error"></div>
      <fieldset><legend>Дні, коли ви приймаєте</legend>
        <div class="radio-row">${WEEKDAYS.map((w, i) => `<label><input type="checkbox" name="w_day" value="${i}" ${d.days.includes(i) ? 'checked' : ''}> ${w}</label>`).join('')}</div>
      </fieldset><div id="w_daysErr" class="error"></div>
      <div class="row" style="justify-content:flex-start;gap:16px">
        <div><label for="w_from">З</label><input id="w_from" class="short" type="time" step="900" value="${esc(d.from)}"></div>
        <div><label for="w_to">До</label><input id="w_to" class="short" type="time" step="900" value="${esc(d.to)}"></div>
      </div><div id="w_timeErr" class="error"></div>
      <p class="hint">Клієнти бачитимуть вільні слоти щогодини в цьому проміжку.</p>`;
    },
    bind(m, d) {
      const [lo, hi] = LEVEL_PRICE[levelFor(d.years)];
      const inp = $('#w_price', m), warn = $('#w_priceWarn', m), net = $('#w_net', m);
      const upd = () => {
        const p = Number(inp.value);
        net.textContent = p > 0 ? `${Math.round(p * (1 - COMMISSION))} грн` : '—';
        const out = p > 0 && (p < lo || p > hi);
        warn.hidden = !out;
        if (out) warn.textContent = p < lo ? 'Ціна нижча за рекомендовану. Можна, але дохід буде меншим.' : 'Ціна вища за рекомендовану. Клієнти можуть рідше вас обирати, поки немає відгуків.';
      };
      upd(); inp.addEventListener('input', upd);
    },
    collect(m, d) {
      d.price = val(m, 'w_price');
      d.days = [...m.querySelectorAll('input[name=w_day]:checked')].map(x => +x.value);
      d.from = val(m, 'w_from'); d.to = val(m, 'w_to');
    },
    validate(m, d) {
      this.collect(m, d);
      const res = { errs: [], first: [] };
      const p = Number(d.price);
      check(Number.isInteger(p) && p >= 50 && p <= 5000, 'w_price', 'Вкажіть ціну цілим числом від 50 до 5000 грн', m, res);
      check(d.days.length > 0, 'w_days', 'Оберіть хоча б один день', m, res, m.querySelector('input[name=w_day]'));
      const okTime = d.from && d.to && toMin(d.to) - toMin(d.from) >= 60;
      check(okTime, 'w_time', 'Проміжок має бути щонайменше годину, і «до» пізніше за «з»', m, res, $('#w_from', m));
      return res;
    },
  },
  5: {
    html: d => {
      const preview = regToPublic({ ...d, id: 'preview', level: levelFor(d.years), price: Number(d.price), status: 'pending' });
      return `
      <p>Так вас бачитимуть клієнти після перевірки:</p>
      ${expertCardHtml(preview)}
      <fieldset class="radio-col"><legend>Умови</legend>
        <label><input type="checkbox" id="a_terms"> Погоджуюсь з умовами для фахівців</label>
        <label><input type="checkbox" id="a_fee"> Розумію, що платформа утримує 20% з кожної консультації</label>
        <label><input type="checkbox" id="a_sens"> Не надаватиму медичних і психологічних консультацій</label>
        <label><input type="checkbox" id="a_verify"> Даю згоду на перевірку документів і обробку персональних даних</label>
      </fieldset>
      <a href="#" id="w_terms" aria-expanded="false">Прочитати умови для фахівців</a>
      <div id="w_termsText" class="card hint" hidden>Фахівець відповідає за зміст консультації і не домовляється з клієнтами про оплату поза платформою. Платформа утримує 20% комісії та виплачує решту щотижня. Порушення правил може призвести до блокування профілю.</div>
      <div id="a_err" class="error"></div>
      <p class="hint">Реквізити для виплат додасте в кабінеті після схвалення заявки.</p>`;
    },
    bind(m) {
      $('#w_terms', m).onclick = e => {
        e.preventDefault();
        const box = $('#w_termsText', m); box.hidden = !box.hidden;
        e.target.setAttribute('aria-expanded', String(!box.hidden));
        if (!box.hidden) log('open_expert_terms');
      };
    },
    validate(m) {
      const res = { errs: [], first: [] };
      const boxes = ['a_terms', 'a_fee', 'a_sens', 'a_verify'].map(id => $('#' + id, m));
      const missing = boxes.filter(b => !b.checked);
      $('#a_err', m).textContent = missing.length ? 'Щоб надіслати заявку, позначте всі умови' : '';
      missing.forEach(b => { res.errs.push(b.id); res.first.push(b); });
      return res;
    },
  },
};

function submitExpert(d) {
  const user = { id: uid('x'), type: 'expert', name: d.name, email: d.email, phone: d.phone, createdAt: Date.now() };
  const rec = {
    id: user.id, name: d.name, email: d.email, phone: d.phone, cat: d.cat, secondary: d.secondary, tags: d.tags,
    about: d.about, position: d.position, years: Number(d.years), education: d.education,
    qualFiles: d.qualFiles, idFile: d.idFile, link: d.link, level: levelFor(d.years), price: Number(d.price),
    days: d.days, from: d.from, to: d.to, status: 'pending', submittedAt: Date.now(),
  };
  db.users.push(user); db.experts.push(rec); db.currentUserId = user.id; db.expertDraft = null;
  commit();
  test.expertSubmittedAt = Date.now();
  if (!test.finishedAt && test.scenario === 'expert') test.finishedAt = test.expertSubmittedAt;
  log('expert_submitted', `напрям=${rec.cat}, рівень=${rec.level}, ціна=${rec.price}, реєстрація ${fmt(test.expertSubmittedAt - test.expertStartedAt)}`);
  nav('/expert-sent');
}

PAGES.expertSent = m => {
  const rec = myExpertRecord();
  if (!rec) return redirect('/become-expert');
  m.innerHTML = `
    <h2>Заявку надіслано ✓</h2>
    <p>Дякуємо, ${esc(rec.name.split(/\s+/)[1] || rec.name)}! Що далі:</p>
    <ol class="how">
      <li>Перевіряємо документи і досвід, зазвичай 1–2 робочі дні.</li>
      <li>Після схвалення профіль з'являється в підборі для клієнтів з теми «${esc(catName(rec.cat))}».</li>
      <li>Бронювання і заробіток ви бачите в кабінеті.</li>
    </ol>
    <div class="actions"><button class="primary" id="cab">Відкрити кабінет ↗</button><button id="home">На головну</button></div>
    <p class="hint">Прототип: заявку можна схвалити кнопкою «Схвалити заявки фахівців» у панелі тесту.</p>`;
  $('#cab', m).onclick = openCabinet;
  $('#home', m).onclick = () => nav('/');
};

/* ---------- Звіт тесту ---------- */
PAGES.results = m => {
  const t = test, now = Date.now();
  const rows = [
    ['Сценарій', SCENARIOS[t.scenario]],
    ['Загальний час', t.startedAt ? fmt((t.finishedAt || now) - t.startedAt) : '—'],
    ['Опис запиту (від першого дотику до надсилання)', t.formStartedAt && t.requestSubmittedAt ? fmt(t.requestSubmittedAt - t.formStartedAt) : '—'],
    ['Від запиту до бронювання', t.requestSubmittedAt && t.bookedAt ? fmt(t.bookedAt - t.requestSubmittedAt) : '—'],
    ['Запусків AI-аналізу', t.aiRuns],
    ['Уточнень для AI', t.clarifications],
    ['«AI неправильно зрозумів тему»', t.aiWrong],
    ['Повторних надсилань опису', t.resubmits],
    ['Реєстрація фахівця', t.expertStartedAt && t.expertSubmittedAt ? fmt(t.expertSubmittedAt - t.expertStartedAt) : '—'],
    ['Помилки фахівця по кроках', Object.entries(t.expertStepErrors).map(([s, n]) => `крок ${s}: ${n}`).join(', ') || '—'],
    ['Кліки', t.clicks], ['Повернення назад', t.backs], ['Помилки валідації', t.errors], ['Змін у полях', t.edits],
  ];
  const times = { ...t.screenTimes };
  m.innerHTML = `
    <h2>Звіт тесту</h2>
    <table>${rows.map(([k, v]) => `<tr><td>${esc(k)}</td><td>${esc(v)}</td></tr>`).join('')}</table>
    <h3>Час на екранах</h3>
    <table>${Object.entries(times).map(([k, v]) => `<tr><td>${esc(k)}</td><td>${fmt(v)}</td></tr>`).join('') || '<tr><td>—</td><td></td></tr>'}</table>
    <div class="actions"><button class="primary" id="exp">Експорт JSON</button><button id="home">На головну</button></div>`;
  $('#exp', m).onclick = exportJSON;
  $('#home', m).onclick = () => nav('/');
};

PAGES.notFound = m => {
  m.innerHTML = `<h2>Сторінку не знайдено</h2><p>Можливо, посилання застаріло або ви увійшли під іншим акаунтом.</p><div class="actions"><button class="primary" id="home">На головну</button></div>`;
  $('#home', m).onclick = () => nav('/');
};

/* ===================== Панель тесту ===================== */
$('#scenario').innerHTML = Object.entries(SCENARIOS).map(([k, v]) => `<option value="${k}">${esc(v)}</option>`).join('');
$('#scenario').onchange = e => { test.scenario = e.target.value; log('scenario', SCENARIOS[test.scenario]); };

// Усі внутрішні посилання ведемо через nav(): так вони працюють і з маршрутом у пам'яті
document.addEventListener('click', e => {
  const a = e.target.closest('a[href^="#/"]');
  if (a && !a.hasAttribute('data-newtab') && !e.ctrlKey && !e.metaKey && !e.shiftKey && e.button === 0) {
    e.preventDefault();
    nav(a.getAttribute('href').slice(1));
  }
}, false);
document.addEventListener('click', e => {
  if (e.target.closest('#panel')) return;
  startTest();
  // Клік по label браузер дублює кліком по його полю — рахуємо лише другий
  const lbl = e.target.closest('label');
  if (lbl && lbl.control && e.target !== lbl.control) return;
  if (e.target.closest('button, a, input, select, label, textarea')) test.clicks++;
}, true);
document.addEventListener('keydown', e => { if (!e.target.closest('#panel')) startTest(); }, true);
$('#main').addEventListener('change', e => {
  if (e.target.matches('input:not([type=checkbox]):not([type=radio]):not([type=file]), textarea, select')) test.edits++;
});

function updatePanel() {
  const now = Date.now(), t = test;
  $('#mTotal').textContent = t.startedAt ? fmt((t.finishedAt || now) - t.startedAt) : '—';
  $('#mScreen').textContent = current ? `${current} · ${fmt(now - screenEnteredAt)}` : '—';
  $('#mForm').textContent = t.formStartedAt ? fmt((t.requestSubmittedAt || now) - t.formStartedAt) : '—';
  $('#mBooking').textContent = t.requestSubmittedAt ? fmt((t.bookedAt || now) - t.requestSubmittedAt) : '—';
  $('#mAi').textContent = `${t.clarifications} / ${t.aiWrong}`;
  $('#mExpert').textContent = t.expertStartedAt ? fmt((t.expertSubmittedAt || now) - t.expertStartedAt) : '—';
  $('#mClicks').textContent = t.clicks;
  $('#mBacks').textContent = t.backs;
  $('#mErrors').textContent = t.errors;
  $('#mEdits').textContent = t.edits;
}
setInterval(updatePanel, 500);
function updatePanelStatic() {
  const pending = db.experts.filter(e => e.status === 'pending').length;
  $('#pendingInfo').textContent = pending ? `Заявок фахівців на перевірці: ${pending}` : 'Заявок на перевірці немає.';
  $('#approveBtn').disabled = !pending;
  $('#storageNote').textContent = storageOK
    ? 'Дані зберігаються в цьому браузері й спільні для всіх вкладок.'
    : 'Сховище недоступне в цьому перегляді: дані живуть лише в цій вкладці до перезавантаження.';
}

function exportJSON() {
  const now = Date.now();
  const data = {
    exportedAt: new Date().toISOString(),
    scenario: SCENARIOS[test.scenario],
    metrics: {
      totalMs: test.startedAt ? (test.finishedAt || now) - test.startedAt : null,
      requestFillMs: test.formStartedAt && test.requestSubmittedAt ? test.requestSubmittedAt - test.formStartedAt : null,
      requestToBookingMs: test.requestSubmittedAt && test.bookedAt ? test.bookedAt - test.requestSubmittedAt : null,
      expertSignupMs: test.expertStartedAt && test.expertSubmittedAt ? test.expertSubmittedAt - test.expertStartedAt : null,
      expertStepErrors: test.expertStepErrors,
      aiRuns: test.aiRuns, aiClarifications: test.clarifications, aiWrongTopic: test.aiWrong, requestResubmits: test.resubmits,
      clicks: test.clicks, backs: test.backs, validationErrors: test.errors, fieldEdits: test.edits,
      screenTimesMs: { ...test.screenTimes, ...(current ? { [current]: (test.screenTimes[current] || 0) + (now - screenEnteredAt) } : {}) },
    },
    currentAnalysis: flow.analysis,
    data: { users: db.users.length, experts: db.experts.map(e => ({ cat: e.cat, level: e.level, price: e.price, status: e.status })), bookings: db.bookings.length },
    events: test.events,
  };
  const json = JSON.stringify(data, null, 2);
  // Запасний варіант: у вбудованому перегляді завантаження файлів заборонене
  $('#exportText').value = json;
  $('#exportFallback').hidden = false;
  if (document.body.classList.contains('no-panel')) togglePanel();
  try {
    const blob = new Blob([json], { type: 'application/json' });
    const a = document.createElement('a');
    a.href = URL.createObjectURL(blob);
    a.download = `usability-${localStamp(new Date())}.json`;
    document.body.appendChild(a); a.click(); a.remove();
    setTimeout(() => URL.revokeObjectURL(a.href), 1000);
  } catch (err) { log('export_error', err.message); }
  log('export');
}
$('#exportBtn').onclick = exportJSON;

// Підтвердження другим натисканням замість confirm(), який у перегляді заблокований
function armButton(btn, label, confirmLabel, action) {
  let armed = null;
  btn.onclick = () => {
    if (!armed) { btn.textContent = confirmLabel; armed = setTimeout(() => { armed = null; btn.textContent = label; }, 3000); return; }
    clearTimeout(armed); armed = null; btn.textContent = label;
    action();
  };
}
armButton($('#resetBtn'), 'Новий учасник', 'Точно почати заново?', () => {
  // Новий учасник: скидаємо метрики і виходимо з акаунта; зареєстровані дані лишаються
  test = freshTest();
  $('#log').textContent = '';
  $('#exportFallback').hidden = true;
  db.currentUserId = null; commit(); flow = freshFlow();
  nav('/');
});
armButton($('#wipeBtn'), 'Очистити всі дані', 'Видалити всіх користувачів?', () => {
  db = emptyDb(); commit(); flow = freshFlow();
  log('wipe_data');
  nav('/');
  render({ silent: true });
});
$('#approveBtn').onclick = () => {
  let n = 0;
  db.experts.forEach(e => { if (e.status === 'pending') { e.status = 'approved'; e.approvedAt = Date.now(); n++; } });
  commit(); log('moderator_approve', String(n));
  render({ silent: true });
};

function togglePanel() {
  const hidden = document.body.classList.toggle('no-panel');
  $('#togglePanel').textContent = hidden ? 'Показати панель тесту' : 'Сховати панель тесту';
}
$('#togglePanel').onclick = togglePanel;

// Синхронізація між вкладками: бронювання з основної вкладки одразу видно в кабінеті
window.addEventListener('storage', e => {
  if (e.key !== STORE_KEY) return;
  try { db = e.newValue ? { ...emptyDb(), ...JSON.parse(e.newValue) } : emptyDb(); } catch { return; }
  renderNav(); updatePanelStatic();
  const ae = document.activeElement;
  const typing = ae && $('#main').contains(ae) && ae.matches('input, textarea, select');
  if (['cabinet', 'home'].includes(current) && !typing) render({ silent: true });
});

// У вкладці кабінету панель тесту за замовчуванням прихована
if (parseHash().name === 'cabinet') togglePanel();
render();
</script>
</body>
</html>
